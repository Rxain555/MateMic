<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MateMic.Windows</AssemblyName>
    <RootNamespace>MateMic.Windows</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- 托盘图标：ICO 嵌入程序集，运行时直接读取，不依赖输出目录的相对路径 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\appicon.ico" LogicalName="MateMic.Windows.appicon.ico" />
  </ItemGroup>

</Project>
