<UserControl x:Class="MateMic.AiComponentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420">

    <!--
      「安装 AI 变声组件」的进度对话框内容（由 Ui\DialogHost.CreateCustom 承载）。

      用户把组件包（.zip）拖到主界面后弹出，显示解压进度。
      解压本身在后台线程，界面不卡；进度完成后对话框关闭，再询问是否立即重启
      —— 装完组件必须重启才生效：程序启动时 AI 降噪已先占用了同名 onnxruntime.dll，
      而 Windows 对同名 DLL 按名字缓存，装完也换不上组件里的 CUDA 版。
    -->
    <StackPanel Margin="0,4,0,2">

        <TextBlock x:Name="TitleText" Text="正在安装组件…"
                   Foreground="{DynamicResource TextBrush}" />

        <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="100" Value="0"
                     Margin="0,12,0,0"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="{DynamicResource TrackBrush}"
                     BorderThickness="0" />

        <TextBlock x:Name="DetailText" Text="准备中…" Margin="0,8,0,0"
                   TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource SubtleTextBrush}" />
    </StackPanel>
</UserControl>
