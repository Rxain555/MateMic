<UserControl x:Class="MateMic.AiComponentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460">

    <!--
      「添加 AI 变声」的对话框内容。
      **刻意不做成独立窗口**：由 Ui\DialogHost.ShowCustom 承载，
      标题栏、描边、圆角、底部按钮全部复用现成样式（2026-10-07 用户指出应当如此）。
    -->
    <StackPanel Margin="0,0,0,2">

        <!-- 拖放区 -->
        <Border x:Name="DropZone" Padding="14,18"
                CornerRadius="6" BorderThickness="1.4"
                BorderBrush="{DynamicResource CardBorderBrush}"
                Background="{DynamicResource WindowSurfaceBrush}"
                AllowDrop="True" DragOver="OnDropZoneDragOver" Drop="OnDropZoneDrop">
            <StackPanel>
                <TextBlock x:Name="DropHintText" Text="把组件文件拖到这里"
                           HorizontalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="（onnxruntime.dll、providers_cuda、CUDA/cuDNN、contentvec.onnx、rmvpe.onnx…）"
                           Margin="0,5,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                           FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />
            </StackPanel>
        </Border>

        <!-- 各组件就绪状态 -->
        <StackPanel Margin="0,14,0,0">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="运行时" Style="{StaticResource LabelText}" />
                <TextBlock x:Name="RuntimeStatusText" Grid.Column="1" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />
            </Grid>
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="推理引擎" Style="{StaticResource LabelText}" />
                <TextBlock x:Name="EngineStatusText" Grid.Column="1" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />
            </Grid>
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="音色模型" Style="{StaticResource LabelText}" />
                <TextBlock x:Name="VoiceStatusText" Grid.Column="1" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />
            </Grid>
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="音色索引" Style="{StaticResource LabelText}" />
                <TextBlock x:Name="IndexStatusText" Grid.Column="1" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />
            </Grid>
        </StackPanel>

        <TextBlock x:Name="ComponentDirText" Margin="0,10,0,0" TextWrapping="Wrap"
                   FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="打开组件文件夹" Style="{StaticResource ToolbarButton}"
                    Padding="10,4,10,4" Margin="0,0,8,0" Click="OnOpenFolderClick" />
            <Button Content="重新检测" Style="{StaticResource ToolbarButton}"
                    Padding="10,4,10,4" Click="OnRefreshClick" />
        </StackPanel>
    </StackPanel>
</UserControl>
