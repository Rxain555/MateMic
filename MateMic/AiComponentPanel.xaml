<UserControl x:Class="MateMic.AiComponentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420">

    <!--
      「添加 AI 变声」的对话框内容（由 Ui\DialogHost.ShowCustom 承载）。

      刻意保持极简（2026-10-08 用户要求"只用显示通用组件和运算组件的就绪状态就行"）：
        · 一个拖放区
        · 两项状态
      其余（音色、索引、目录路径、操作按钮）一概不放 ——
      音色与索引由用户直接拖到主界面；"打开组件文件夹"用对话框现成的次要按钮。
    -->
    <StackPanel Margin="0,0,0,2">

        <!-- 拖放区 -->
        <Border x:Name="DropZone" Padding="14,20"
                CornerRadius="6" BorderThickness="1.4"
                BorderBrush="{DynamicResource CardBorderBrush}"
                Background="{DynamicResource WindowSurfaceBrush}"
                AllowDrop="True" DragOver="OnDropZoneDragOver" Drop="OnDropZoneDrop"
                MouseLeftButtonUp="OnDropZoneClick">
            <StackPanel>
                <TextBlock x:Name="DropHintText" Text="把组件包拖到这里"
                           HorizontalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="支持 .zip 组件包（自动解压安装）、解压后的文件夹，或零散文件"
                           Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                           FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />
                <TextBlock Text="点这里也可以选择文件"
                           Margin="0,3,0,0" HorizontalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />
            </StackPanel>
        </Border>

        <!-- 只两项状态 -->
        <Grid Margin="0,16,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="通用组件" Style="{StaticResource LabelText}" />
            <TextBlock x:Name="CoreStatusText" Grid.Column="1" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextBrush}" />
        </Grid>
        <Grid Margin="0,3,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="运算组件" Style="{StaticResource LabelText}" />
            <TextBlock x:Name="ProviderStatusText" Grid.Column="1" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextBrush}" />
        </Grid>
    </StackPanel>
</UserControl>
