<Window x:Class="MateMic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="MateMic" Height="800" Width="1180"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="OnClosing" StateChanged="OnStateChanged"
        SourceInitialized="OnSourceInitialized"
        KeyDown="OnWindowKeyDown" PreviewKeyDown="OnWindowPreviewKeyDown"
        TextInput="OnWindowTextInput">

    <!--
      自绘标题栏（WindowChrome + WindowStyle=None）。
      为什么不用系统标题栏：窗口是固定尺寸的，系统标题栏要么三个按钮都有（最大化点了没用），
      要么用 WPF 的 ResizeMode="NoResize" 把最小化和最大化**一起**清掉（用户报的"最小化不见了"）。
      实测过在运行时改窗口样式位，DWM 已绘制的标题栏不会跟着重算，最大化按钮照样在。
      因此改为：标题栏由我们自己画，只画「最小化 + 关闭」两个按钮，行为精确可控。
      CaptionHeight 给 0：拖动区域由标题栏那一行自己承担（MouseLeftButtonDown 调 DragMove），
      不需要系统再介入，避免与自定义按钮抢命中测试。

      ⚠ ResizeMode 必须留在 CanMinimize（**不能**改回 NoResize）：
      NoResize 会把 WS_MINIMIZEBOX 一起清掉，于是**点任务栏按钮无法最小化**，
      也没有最小化/还原动画（2026-10-03 用户报的问题）。CanMinimize = 有最小化、无最大化、不可拉伸。

      ⚠ WindowStyle **必须留在 SingleBorderWindow（不能改回 None）**：
      最小化 / 还原的 **DWM 过渡动画需要窗口带 WS_CAPTION**，而 WindowStyle=None 会把它清掉 ——
      表现就是"窗口一下就没了 / 一下就出现，没有向任务栏收缩或从任务栏展开的动画"
      （2026-10-03 用户报的第二个问题）。可见的边框与标题栏由下面的 WindowChrome 去掉：
      CaptionHeight=0 + UseAeroCaptionButtons=False，WPF 会把整个窗口当客户区处理，
      因此加了 WS_CAPTION 也不会出现系统标题栏或系统按钮。
      窗口样式位的自检见 WindowEffects.LogCaptionButtonState（应看到 系统标题栏=True）。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 自绘标题栏：应用图标 + 名称 + 拖动区 + 最小化/关闭 ============ -->
        <Border x:Name="CaptionBar" Grid.Row="0" Background="{DynamicResource AcrylicTopBarBrush}"
                MouseLeftButtonDown="OnCaptionBarMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <Image x:Name="CaptionIcon" Width="16" Height="16" Margin="0,0,7,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="MateMic" Style="{StaticResource LabelText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CaptionMinimizeButton" Style="{StaticResource CaptionButton}"
                            Click="OnCaptionMinimizeClick" ToolTip="最小化" Content="min" />
                    <Button x:Name="CaptionCloseButton" Style="{StaticResource CaptionCloseButton}"
                            Click="OnCaptionCloseClick" ToolTip="关闭" Content="close" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 顶部工具栏：两行。
             第一行放开关类（末尾跟版本号），第二行专门放三个设备下拉框——
             设备名往往很长（"Realtek Digital Output (Realtek High Definition Audio)" 有 300 DIP 宽），
             挤在第一行里只能分到 98 DIP，等于看不到设备名。
             背景刻意做成"磨砂玻璃"：亚克力材质从窗口背后透上来，
             这里只加一层很淡的白，靠底边一条阴影把内容区压在下面，不再用深色描边。 -->
        <Border x:Name="TopBar" Grid.Row="1" Background="{DynamicResource AcrylicTopBarBrush}"
                BorderThickness="0" Padding="10,7,10,7">
                        <Border.Effect>
                <!-- 主题里的顶栏投影：深色模式下会换成黑色投影 -->
                <DynamicResource ResourceKey="TopBarShadow" />
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource LabelText}" Text="音频处理" Margin="0,0,5,0" />
                    <CheckBox x:Name="ToggleProcessing" Style="{StaticResource Switch}" Margin="0,0,12,0"
                              Checked="OnProcessingToggled" Unchecked="OnProcessingToggled"
                              ToolTip="总旁通开关：关闭后麦克风静音（播放器仍可送出）" />

                    <TextBlock Style="{StaticResource LabelText}" Text="全局快捷键" Margin="0,0,5,0" />
                    <Button x:Name="HotkeyButton" Style="{StaticResource ToolbarButton}"
                            Width="118" Margin="0,0,12,0" Click="OnGlobalHotkeyClick"
                            Content="点击输入快捷键"
                            ToolTip="点击后按下组合键，即可为「音频处理」总开关绑定全局快捷键。注意：全局快捷键会被 MateMic 独占，其他程序（含文本输入框）不会再收到该按键，建议使用带 Ctrl / Alt 的组合键。" />

                    <TextBlock Style="{StaticResource LabelText}" Text="监听" Margin="0,0,5,0" />
                    <CheckBox x:Name="ToggleMonitor" Style="{StaticResource Switch}" Margin="0,0,12,0"
                              Checked="OnMonitorToggled" Unchecked="OnMonitorToggled"
                              ToolTip="让麦克风进监听（物理扬声器）。与右侧播放器的「音频监听」是两个独立开关，四种组合：&#x0a;· 都关：没有监听；&#x0a;· 只开这个：只听麦克风；&#x0a;· 只开音频监听：只听播放的音频；&#x0a;· 都开：麦克风 + 播放的音频。" />

                    <TextBlock Style="{StaticResource LabelText}" Text="开机自启" Margin="0,0,5,0" />
                    <CheckBox x:Name="ToggleAutoStart" Style="{StaticResource Switch}" Margin="0,0,12,0"
                              Checked="OnAutoStartToggled" Unchecked="OnAutoStartToggled" />

                    <TextBlock Style="{StaticResource LabelText}" Text="关闭到托盘" Margin="0,0,5,0" />
                    <CheckBox x:Name="ToggleCloseTray" Style="{StaticResource Switch}" Margin="0,0,12,0"
                              Checked="OnTrayToggled" Unchecked="OnTrayToggled"
                              ToolTip="打开：点右上角关闭按钮时收进系统托盘（双击托盘图标恢复）。关闭：关闭按钮直接退出程序。最小化按钮始终只最小化到任务栏。" />
                    <TextBlock Style="{StaticResource LabelText}" Text="深色模式" Margin="0,0,5,0" />
                    <CheckBox x:Name="ToggleDarkMode" Style="{StaticResource Switch}"
                              Checked="OnDarkModeToggled" Unchecked="OnDarkModeToggled"
                              ToolTip="切换深色 / 浅色配色。深色配色在暗环境下更护眼；设置会保存，下次启动继续沿用。" />

                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <!--
                          使用指南：设备下拉框到底该选什么、软件怎么用，是新人最容易懵的地方。
                          做成和「风险说明」同一种按钮，点开一个自绘对话框，不占主界面空间。
                        -->
                        <Button x:Name="UsageGuideButton" Style="{StaticResource ToolbarButton}"
                                Content="使用指南" Padding="8,3,8,3" Margin="0,0,6,0"
                                Click="OnUsageGuideClick"
                                ToolTip="Windows 声音设置、设备选择、MIXLINE 接法" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource LabelText}"
                                   Text="v0.1.0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 三个设备下拉框带标签，等宽星号列 → 三组元素均匀铺满整行；
                     ToolTip 由代码在选中项变化时设为设备的完整名称
                     （万一设备名比框还长，悬停就能看到全名）。 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="输入" Margin="0,0,4,0" />
                    <ComboBox x:Name="InputDeviceCombo" Grid.Column="1" Style="{StaticResource DeviceCombo}"
                              ItemContainerStyle="{StaticResource FlatComboItem}"
                              DropDownOpened="OnDeviceDropDownOpened" SelectionChanged="OnDeviceSelectionChanged" />

                    <TextBlock Grid.Column="3" Style="{StaticResource LabelText}" Text="输出" Margin="0,0,4,0" />
                    <ComboBox x:Name="OutputDeviceCombo" Grid.Column="4" Style="{StaticResource DeviceCombo}"
                              ItemContainerStyle="{StaticResource FlatComboItem}"
                              DropDownOpened="OnDeviceDropDownOpened" SelectionChanged="OnDeviceSelectionChanged" />

                    <TextBlock Grid.Column="6" Style="{StaticResource LabelText}" Text="监听" Margin="0,0,4,0" />
                    <ComboBox x:Name="MonitorDeviceCombo" Grid.Column="7" Style="{StaticResource DeviceCombo}"
                              ItemContainerStyle="{StaticResource FlatComboItem}"
                              DropDownOpened="OnDeviceDropDownOpened" SelectionChanged="OnDeviceSelectionChanged" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 主体三栏：分组容器（红色框）内直接放功能模块卡（紫色 / 绿色框），只有两层 -->
        <!-- 主体三栏：分组容器（红色框）内直接放功能模块卡（紫色 / 绿色框），只有两层。
             底部留 6px：否则三栏容器的圆角底边会与窗口底边完全重合，
             看起来像"三个层级的底边叠在一起"。 -->
        <Grid Grid.Row="2" Margin="6,6,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" MinWidth="330" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左栏：音频处理链 ============ -->
            <Border Grid.Column="0" Style="{StaticResource GroupContainer}" Margin="0,0,7,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource GroupTitle}" Text="音频处理链" />

                    <!-- 左右不留内边距：右边的 4px 是给滚动条预留的，会让卡片左右不对称。
                         滚动条按需覆盖在内容上方（Auto 模式的常规做法）。 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,6">
                        <StackPanel>
                            <!-- 噪声门 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="噪声门" />
                                        <CheckBox x:Name="ToggleGate" Grid.Column="1" Style="{StaticResource Switch}"
                                                  Margin="0,0,8,0" Checked="OnEffectToggled"
                                                  Unchecked="OnEffectToggled" />
                                        <Button x:Name="ExpandGate" Grid.Column="2"
                                                Style="{StaticResource ExpanderButton}"
                                                Click="OnExpandClick" Tag="{Binding GateExpanded, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <StackPanel x:Name="PanelGate" Visibility="Collapsed" Margin="0,6,0,0">
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="阈值" />
                                            <Slider x:Name="GateThresholdSlider" Grid.Column="1"
                                                    Style="{StaticResource FlatSlider}" Minimum="-80" Maximum="0"
                                                    Value="-55" Tag="GateThreshold" ValueChanged="OnSliderChanged" />
                                        </Grid>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                       Text="释放时间" />
                                            <Slider x:Name="GateReleaseSlider" Grid.Column="1"
                                                    Style="{StaticResource FlatSlider}" Minimum="10" Maximum="600"
                                                    Value="150" Tag="GateRelease" ValueChanged="OnSliderChanged" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- AI 降噪 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="AI 降噪" />
                                        <CheckBox x:Name="ToggleDenoise" Grid.Column="1"
                                                  Style="{StaticResource Switch}" Margin="0,0,8,0"
                                                  Checked="OnEffectToggled" Unchecked="OnEffectToggled" />
                                        <Button x:Name="ExpandDenoise" Grid.Column="2"
                                                Style="{StaticResource ExpanderButton}"
                                                Click="OnExpandClick" Tag="{Binding DenoiseExpanded, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <StackPanel x:Name="PanelDenoise" Visibility="Collapsed" Margin="0,6,0,0">
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="模型" />
                                            <ComboBox x:Name="ModelCombo" Grid.Column="1"
                                                      Style="{StaticResource FlatCombo}"
                                                      ItemContainerStyle="{StaticResource FlatComboItem}"
                                                      DropDownOpened="OnModelDropDownOpened"
                                                      SelectionChanged="OnModelSelectionChanged" />
                                            <!-- 打开模型文件夹：原先是独立卡片，现挪到模型下拉框右侧，不占额外空间 -->
                                            <Button x:Name="OpenModelsFolderButton" Grid.Column="2"
                                                    Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                                    Click="OnOpenModelsFolderClick"
                                                    ToolTip="打开降噪模型文件夹">
                                                <Path Data="M 1 3 L 5 3 L 6.5 5 L 13 5 L 13 12 L 1 12 Z"
                                                      Stroke="{DynamicResource IconGlyphBrush}" StrokeThickness="1.3"
                                                      StrokeLineJoin="Round" Fill="Transparent" />
                                            </Button>
                                        </Grid>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                       Text="降噪强度" />
                                            <Slider x:Name="DenoiseStrengthSlider" Grid.Column="1"
                                                    Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                                                    Value="100" Tag="DenoiseStrength" ValueChanged="OnSliderChanged" />
                                        </Grid>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                       Text="干湿比" />
                                            <Slider x:Name="DenoiseWetSlider" Grid.Column="1"
                                                    Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                                                    Value="100" Tag="DenoiseWet" ValueChanged="OnSliderChanged" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 响度平衡 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}"
                                                   Text="响度平衡" />
                                        <CheckBox x:Name="ToggleLoudness" Grid.Column="1"
                                                  Style="{StaticResource Switch}" Margin="0,0,8,0"
                                                  Checked="OnEffectToggled" Unchecked="OnEffectToggled" />
                                        <Button x:Name="ExpandLoudness" Grid.Column="2"
                                                Style="{StaticResource ExpanderButton}"
                                                Click="OnExpandClick" Tag="{Binding LoudnessExpanded, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <StackPanel x:Name="PanelLoudness" Visibility="Collapsed" Margin="0,6,0,0">
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                       Text="目标响度" />
                                            <Slider x:Name="LoudnessTargetSlider" Grid.Column="1"
                                                    Style="{StaticResource FlatSlider}" Minimum="-30" Maximum="-8"
                                                    Value="-20" Tag="LoudnessTarget"
                                                    ValueChanged="OnSliderChanged"
                                                    ToolTip="麦克风信号的平均电平要拉到多少 dBFS。说话偏小就把目标调高（如 −16），偏大就调低（如 −24）。" />
                                        </Grid>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                       Text="响应速度" />
                                            <Slider x:Name="LoudnessSpeedSlider" Grid.Column="1"
                                                    Style="{StaticResource FlatSlider}" Minimum="1" Maximum="10"
                                                    Value="5" Tag="LoudnessSpeed" ValueChanged="OnSliderChanged"
                                                    ToolTip="增益跟随音量变化的快慢。数值越大反应越快（约 2.5 秒 → 0.15 秒）；太快会有明显的抽吸感，太慢会跟不上。" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 音色风格 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}"
                                                   Text="音色风格" />
                                        <CheckBox x:Name="ToggleTone" Grid.Column="1"
                                                  Style="{StaticResource Switch}" Margin="0,0,8,0"
                                                  Checked="OnEffectToggled" Unchecked="OnEffectToggled" />
                                        <Button x:Name="ExpandTone" Grid.Column="2"
                                                Style="{StaticResource ExpanderButton}"
                                                Click="OnExpandClick" Tag="{Binding ToneExpanded, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <UniformGrid x:Name="ToneGrid" Columns="6" Margin="0,6,0,0"
                                                 Visibility="Collapsed">
                                        <RadioButton Style="{StaticResource ChipToggle}" Content="清亮" Tag="Bright"
                                                     Click="OnToneSelected" />
                                        <RadioButton Style="{StaticResource ChipToggle}" Content="沉稳" Tag="Warm"
                                                     Click="OnToneSelected" />
                                        <RadioButton Style="{StaticResource ChipToggle}" Content="深邃" Tag="Deep"
                                                     Click="OnToneSelected" />
                                        <RadioButton Style="{StaticResource ChipToggle}" Content="尖锐" Tag="Sharp"
                                                     Click="OnToneSelected" />
                                        <RadioButton Style="{StaticResource ChipToggle}" Content="空灵" Tag="Ethereal"
                                                     Click="OnToneSelected" />
                                        <RadioButton Style="{StaticResource ChipToggle}" Content="自然" Tag="Natural"
                                                     Click="OnToneSelected" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- 效果器 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="效果器" />
                                        <CheckBox x:Name="ToggleEffect" Grid.Column="1"
                                                  Style="{StaticResource Switch}" Margin="0,0,8,0"
                                                  Checked="OnEffectToggled" Unchecked="OnEffectToggled" />
                                        <Button x:Name="ExpandEffect" Grid.Column="2"
                                                Style="{StaticResource ExpanderButton}"
                                                Click="OnExpandClick" Tag="{Binding EffectExpanded, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <StackPanel x:Name="PanelCreative" Visibility="Collapsed" Margin="0,6,0,0">
                                        <UniformGrid x:Name="EffectGrid" Columns="5">
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="混响" Tag="Reverb"
                                                         Click="OnCreativeEffectSelected" />
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="延迟" Tag="Delay"
                                                         Click="OnCreativeEffectSelected" />
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="合唱" Tag="Chorus"
                                                         Click="OnCreativeEffectSelected" />
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="电音" Tag="Robot"
                                                         Click="OnCreativeEffectSelected" />
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="炸麦" Tag="Megaphone"
                                                         Click="OnCreativeEffectSelected" />
                                        </UniformGrid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                       Text="效果强度" />
                                            <Slider x:Name="EffectAmountSlider" Grid.Column="1"
                                                    Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                                                    Value="55" Tag="EffectAmount" ValueChanged="OnSliderChanged" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 增益 -->
                            <Border Style="{StaticResource CardLast}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="增益" />
                                        <CheckBox x:Name="ToggleGain" Grid.Column="1" Style="{StaticResource Switch}"
                                                  Margin="0,0,8,0" Checked="OnEffectToggled"
                                                  Unchecked="OnEffectToggled" />
                                        <Button x:Name="ExpandGain" Grid.Column="2"
                                                Style="{StaticResource ExpanderButton}"
                                                Click="OnExpandClick" Tag="{Binding GainExpanded, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <StackPanel x:Name="PanelGain" Visibility="Collapsed" Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                       Text="增益强度" />
                                            <Slider x:Name="GainSlider" Grid.Column="1"
                                                    Style="{StaticResource FlatSlider}" Minimum="-24" Maximum="24"
                                                    Value="0" Tag="GainDb" ValueChanged="OnSliderChanged" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ 中栏：实时频谱 ============ -->
            <Border Grid.Column="1" Style="{StaticResource GroupContainer}" Margin="0,0,7,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource GroupTitle}" Text="实时频谱" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 输入频谱：占上半剩余空间 -->
                            <RowDefinition Height="*" MinHeight="90" />
                            <!-- 输出频谱：占下半剩余空间 -->
                            <RowDefinition Height="*" MinHeight="90" />
                            <!-- RMS 电平条：放在最下面 -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 输入频谱 -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="6">
                            <Grid>
                                <TextBlock Style="{StaticResource LabelText}" Text="输入"
                                           HorizontalAlignment="Center" VerticalAlignment="Top"
                                           Margin="0,2,0,0" Panel.ZIndex="2" />
                                <Canvas x:Name="InputSpectrumCanvas" ClipToBounds="True" Margin="0,20,0,0" />
                            </Grid>
                        </Border>

                        <!-- 输出频谱 -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                            <Grid>
                                <TextBlock Style="{StaticResource LabelText}" Text="输出"
                                           HorizontalAlignment="Center" VerticalAlignment="Top"
                                           Margin="0,2,0,0" Panel.ZIndex="2" />
                                <Canvas x:Name="OutputSpectrumCanvas" ClipToBounds="True" Margin="0,20,0,0" />
                            </Grid>
                        </Border>

                        <!-- RMS 电平条：直接贴着容器，不再套一层卡片边框（原来层级太多）。
                             上下间距相等，两端与容器同宽。 -->
                        <Border Grid.Row="2" Background="Transparent" BorderThickness="0"
                                Margin="0,6,0,6" Padding="0">
                            <Grid Height="16" x:Name="LevelTrack">
                                <Rectangle RadiusX="8" RadiusY="8">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#5CD65C" Offset="0" />
                                            <GradientStop Color="#5CD65C" Offset="0.55" />
                                            <GradientStop Color="#F2C744" Offset="0.62" />
                                            <GradientStop Color="#F2C744" Offset="0.86" />
                                            <GradientStop Color="#F26B6B" Offset="0.92" />
                                            <GradientStop Color="#F26B6B" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Border x:Name="LevelMask" HorizontalAlignment="Right"
                                        Background="{DynamicResource LevelMaskBrush}"
                                        Opacity="0.85" Width="0" CornerRadius="0,8,8,0" />
                                <Rectangle x:Name="LevelNeedle" Width="2" Fill="{DynamicResource LevelNeedleBrush}"
                                           HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ============ 右栏：播放伴奏 / 语音包 ============ -->
            <Border Grid.Column="2" Style="{StaticResource GroupContainer}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource GroupTitle}" Text="播放音频" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 路由开关 + 音量 -->
                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LabelText}" Text="音频监听" />
                                    <CheckBox x:Name="ToggleAudioMonitor" Style="{StaticResource Switch}"
                                              Margin="6,0,14,0" Checked="OnAudioMonitorToggled"
                                              Unchecked="OnAudioMonitorToggled"
                                              ToolTip="播放器音频（伴奏 / 语音包）是否接入混音总线。&#x0a;· 打开：播放器进主输出（MIXLINE，队友能听到），并在工具栏「监听」打开时进监听设备。&#x0a;· 关闭：两条输出都没有播放器音频。&#x0a;配合工具栏「监听」的四种组合：都关=没有监听；只开音频监听=只听播放器；只开监听=只听麦克风；都开=麦克风+播放器。" />
                                    <TextBlock Style="{StaticResource LabelText}" Text="循环播放" />
                                    <CheckBox x:Name="ToggleLoop" Style="{StaticResource Switch}" Margin="6,0,0,0"
                                              Checked="OnLoopToggled" Unchecked="OnLoopToggled" />
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="播放音量" />
                                    <Slider x:Name="PlayerVolumeSlider" Grid.Column="1"
                                            Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                                            Value="80" ValueChanged="OnPlayerVolumeChanged" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="同步按住键" />
                                    <CheckBox x:Name="ToggleHoldKey" Grid.Column="1" Style="{StaticResource Switch}"
                                              Margin="6,0,10,0" Checked="OnHoldKeyToggled"
                                              Unchecked="OnHoldKeyToggled"
                                              ToolTip="启用后，可以为每个音频文件指定一个按键：播放前自动按下、播放结束后自动松开，用来替代游戏/语音软件里「按键说话」的手动按键。用 Win32 SendInput 注入按键，内核级反作弊（Vanguard / EAC / BattlEye 等）有能力识别注入事件，存在被判定风险，默认关闭。启用时会弹窗说明。" />
                                    <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="风险说明"
                                            Padding="6,1,6,1" HorizontalAlignment="Left"
                                            Click="OnHoldKeyRiskClick" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="1" Style="{StaticResource FlatButton}" Content="添加音频文件"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="OnAddFilesClick" />

                        <!-- 音频列表 -->
                        <Border Grid.Row="2" Style="{StaticResource CardLast}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource HeaderSurfaceBrush}"
                                        CornerRadius="7,7,0,0">
                                    <TextBlock Style="{StaticResource LabelText}" Text="音频列表"
                                               HorizontalAlignment="Center" Margin="0,5,0,5" />
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="TrackList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="30" Cursor="Hand"
                                                      MouseLeftButtonUp="OnTrackRowClick"
                                                      ToolTip="点击播放；正在播放时再点一次即停止。右侧两个按钮分别设置「全局播放快捷键」与「同步按住键」，最右侧 ✕ 移除">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}"
                                                                             Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource AccentSoftHoverBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <!--
                                                        两列按键控件的宽度**由内容决定**（绑定到实测文字宽度）：
                                                        TrackViewModel 用 FormattedText 按控件实际字号量出文字宽度再加内边距，
                                                        所以占位符「设快捷键 / 设同步键」时只有 ~60 DIP（比原来的 92 / 88 窄），
                                                        而长键位（例：Ctrl + Alt + Shift + F12 ≈ 136 DIP）也不会被截断。
                                                        Auto 列 + 不打折的 * 列：省下的宽度全归文件名。
                                                    -->
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="2" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="26" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Style="{StaticResource LabelText}"
                                                               Text="{Binding DisplayName}" Margin="8,0,4,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FilePath}" />
                                                    <Button Grid.Column="1"
                                                            Content="{Binding HotkeyText}"
                                                            Width="{Binding HotkeyButtonWidth}"
                                                            Click="OnTrackHotkeyClick" Tag="{Binding}"
                                                            ToolTip="{Binding HotkeyButtonTooltip}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource InputBoxButton}">
                                                                <Style.Triggers>
                                                                    <!-- 未绑定时显示成灰字占位符（像输入框的 placeholder） -->
                                                                    <DataTrigger Binding="{Binding IsHotkeySet}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource PlaceholderBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Grid.Column="3"
                                                            Content="{Binding HoldKeyText}"
                                                            Width="{Binding HoldKeyButtonWidth}"
                                                            IsEnabled="{Binding HoldKeyEnabled}"
                                                            Click="OnTrackHoldKeyClick" Tag="{Binding}"
                                                            ToolTip="{Binding HoldKeyTooltip}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource InputBoxButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHoldKeySet}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource PlaceholderBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Grid.Column="4" Style="{StaticResource RemoveButton}"
                                                            Click="OnTrackRemoveClick" Tag="{Binding}"
                                                            ToolTip="从列表移除该音频文件" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- 空列表提示（默认状态） -->
                                <TextBlock x:Name="TrackListEmptyHint" Grid.Row="1"
                                           Style="{StaticResource SmallText}"
                                           Text="列表为空，点击上方「添加音频文件」添加伴奏或语音包"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="12,0,12,0" TextWrapping="Wrap" TextAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 状态条（MIXLINE 提示 / 设备掉线 / 错误） -->
        <Border x:Name="StatusBar" Grid.Row="2" Background="{DynamicResource WarningBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="8"
                Padding="10,6,10,6" Margin="8,6,8,8" VerticalAlignment="Bottom" Visibility="Collapsed"
                Panel.ZIndex="5">
                        <Border.Effect>
                <DynamicResource ResourceKey="TopBarShadow" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Style="{StaticResource LabelText}"
                           Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
                <Button x:Name="StatusActionButton" Grid.Column="1" Style="{StaticResource FlatButton}"
                        Content="查看设置指南" Margin="8,0,0,0" Visibility="Collapsed"
                        Click="OnStatusActionClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
