<Window x:Class="MateMic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:MateMic.Ui"
        mc:Ignorable="d"
        Title="MateMic" Height="800" Width="1180"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        Background="{DynamicResource WindowBrush}"
        FontFamily="{DynamicResource AppFont}" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="OnClosing" StateChanged="OnStateChanged"
        SourceInitialized="OnSourceInitialized"
        KeyDown="OnWindowKeyDown" PreviewKeyDown="OnWindowPreviewKeyDown"
        TextInput="OnWindowTextInput">

    <!--
      自绘标题栏（WindowChrome + WindowStyle=None）。
      为什么不用系统标题栏：窗口是固定尺寸的，系统标题栏要么三个按钮都有（最大化点了没用），
      要么用 WPF 的 ResizeMode="NoResize" 把最小化和最大化**一起**清掉（用户报的"最小化不见了"）。
      实测过在运行时改窗口样式位，DWM 已绘制的标题栏不会跟着重算，最大化按钮照样在。
      因此改为：标题栏由我们自己画，只画「最小化 + 关闭」两个按钮，行为精确可控。
      CaptionHeight 给 0：拖动区域由标题栏那一行自己承担（MouseLeftButtonDown 调 DragMove），
      不需要系统再介入，避免与自定义按钮抢命中测试。

      ⚠ ResizeMode 必须留在 CanMinimize（**不能**改回 NoResize）：
      NoResize 会把 WS_MINIMIZEBOX 一起清掉，于是**点任务栏按钮无法最小化**，
      也没有最小化/还原动画（2026-10-03 用户报的问题）。CanMinimize = 有最小化、无最大化、不可拉伸。

      ⚠ WindowStyle **必须留在 SingleBorderWindow（不能改回 None）**：
      最小化 / 还原的 **DWM 过渡动画需要窗口带 WS_CAPTION**，而 WindowStyle=None 会把它清掉 ——
      表现就是"窗口一下就没了 / 一下就出现，没有向任务栏收缩或从任务栏展开的动画"
      （2026-10-03 用户报的第二个问题）。可见的边框与标题栏由下面的 WindowChrome 去掉：
      CaptionHeight=0 + UseAeroCaptionButtons=False，WPF 会把整个窗口当客户区处理，
      因此加了 WS_CAPTION 也不会出现系统标题栏或系统按钮。
      窗口样式位的自检见 WindowEffects.LogCaptionButtonState（应看到 系统标题栏=True）。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 自绘标题栏：应用图标 + 名称 + 拖动区 + 最小化/关闭 ============ -->
        <Border x:Name="CaptionBar" Grid.Row="0" Background="{DynamicResource AcrylicTopBarBrush}"
                MouseLeftButtonDown="OnCaptionBarMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <Image x:Name="CaptionIcon" Width="16" Height="16" Margin="0,0,7,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="MateMic" Style="{StaticResource LabelText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CaptionMinimizeButton" Style="{StaticResource CaptionButton}"
                            Click="OnCaptionMinimizeClick" Content="min" />
                    <Button x:Name="CaptionCloseButton" Style="{StaticResource CaptionCloseButton}"
                            Click="OnCaptionCloseClick" Content="close" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 顶部工具栏：两行。
             第一行放开关类（末尾跟版本号），第二行专门放三个设备下拉框——
             设备名往往很长（"Realtek Digital Output (Realtek High Definition Audio)" 有 300 DIP 宽），
             挤在第一行里只能分到 98 DIP，等于看不到设备名。
             背景刻意做成"磨砂玻璃"：亚克力材质从窗口背后透上来，
             这里只加一层很淡的白，靠底边一条阴影把内容区压在下面，不再用深色描边。 -->
        <Border x:Name="TopBar" Grid.Row="1" Background="{DynamicResource AcrylicTopBarBrush}"
                BorderThickness="0" Padding="10,7,10,7">
                        <Border.Effect>
                <!-- 主题里的顶栏投影：深色模式下会换成黑色投影 -->
                <DynamicResource ResourceKey="TopBarShadow" />
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource LabelText}" Text="音频处理" Margin="0,0,5,0" />
                    <CheckBox x:Name="ToggleProcessing" Style="{StaticResource Switch}" Margin="0,0,12,0"
                              Checked="OnProcessingToggled" Unchecked="OnProcessingToggled" />

                    <TextBlock Style="{StaticResource LabelText}" Text="全局快捷键" Margin="0,0,5,0" />
                    <Button x:Name="HotkeyButton" Style="{StaticResource ToolbarButton}"
                            Width="118" Margin="0,0,12,0" Click="OnGlobalHotkeyClick"
                            Content="点击输入快捷键" />

                    <TextBlock Style="{StaticResource LabelText}" Text="监听" Margin="0,0,5,0" />
                    <CheckBox x:Name="ToggleMonitor" Style="{StaticResource Switch}" Margin="0,0,12,0"
                              Checked="OnMonitorToggled" Unchecked="OnMonitorToggled" />

                    <TextBlock Style="{StaticResource LabelText}" Text="开机自启" Margin="0,0,5,0" />
                    <CheckBox x:Name="ToggleAutoStart" Style="{StaticResource Switch}" Margin="0,0,12,0"
                              Checked="OnAutoStartToggled" Unchecked="OnAutoStartToggled"/>

                    <TextBlock Style="{StaticResource LabelText}" Text="关闭到托盘" Margin="0,0,5,0" />
                    <CheckBox x:Name="ToggleCloseTray" Style="{StaticResource Switch}" Margin="0,0,12,0"
                              Checked="OnTrayToggled" Unchecked="OnTrayToggled" />
                    <TextBlock Style="{StaticResource LabelText}" Text="深色模式" Margin="0,0,5,0" />
                    <CheckBox x:Name="ToggleDarkMode" Style="{StaticResource Switch}"
                              Checked="OnDarkModeToggled" Unchecked="OnDarkModeToggled" />

                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <!--
                          使用指南：设备下拉框到底该选什么、软件怎么用，是新人最容易懵的地方。
                          做成和「风险说明」同一种按钮，点开一个自绘对话框，不占主界面空间。
                        -->
                        <Button x:Name="UsageGuideButton" Style="{StaticResource ToolbarButton}"
                                Content="使用指南" Padding="8,3,8,3" Margin="0,0,6,0"
                                Click="OnUsageGuideClick" />
                        <!--
                          关于：字体 / 降噪模型 / 第三方组件的署名与许可集中放这里。
                          一是 MiSans 的授权要求"应在软件中特别注明"，
                          二是用户自己放进 models\ 的模型，其许可与本程序无关，一并讲清楚。
                        -->
                        <Button x:Name="AboutButton" Style="{StaticResource ToolbarButton}"
                                Content="关于" Padding="8,3,8,3" Margin="0,0,6,0"
                                Click="OnAboutClick" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource LabelText}"
                                   Text="v0.1.0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 三个设备下拉框带标签，等宽星号列 → 三组元素均匀铺满整行；
                     ToolTip 由代码在选中项变化时设为设备的完整名称
                     （万一设备名比框还长，悬停就能看到全名）。 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="输入" Margin="0,0,4,0" />
                    <ComboBox x:Name="InputDeviceCombo" Grid.Column="1" Style="{StaticResource DeviceCombo}"
                              ItemContainerStyle="{StaticResource FlatComboItem}"
                              DropDownOpened="OnDeviceDropDownOpened" SelectionChanged="OnDeviceSelectionChanged"/>

                    <TextBlock Grid.Column="3" Style="{StaticResource LabelText}" Text="输出" Margin="0,0,4,0" />
                    <ComboBox x:Name="OutputDeviceCombo" Grid.Column="4" Style="{StaticResource DeviceCombo}"
                              ItemContainerStyle="{StaticResource FlatComboItem}"
                              DropDownOpened="OnDeviceDropDownOpened" SelectionChanged="OnDeviceSelectionChanged"/>

                    <TextBlock Grid.Column="6" Style="{StaticResource LabelText}" Text="监听" Margin="0,0,4,0" />
                    <ComboBox x:Name="MonitorDeviceCombo" Grid.Column="7" Style="{StaticResource DeviceCombo}"
                              ItemContainerStyle="{StaticResource FlatComboItem}"
                              DropDownOpened="OnDeviceDropDownOpened" SelectionChanged="OnDeviceSelectionChanged"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 主体三栏：分组容器（红色框）内直接放功能模块卡（紫色 / 绿色框），只有两层 -->
        <!-- 主体三栏：分组容器（红色框）内直接放功能模块卡（紫色 / 绿色框），只有两层。
             底部留 6px：否则三栏容器的圆角底边会与窗口底边完全重合，
             看起来像"三个层级的底边叠在一起"。 -->
        <Grid Grid.Row="2" Margin="6,6,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" MinWidth="330" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左栏：音频处理 ============ -->
            <Border x:Name="LeftRegion" Grid.Column="0" Style="{StaticResource RegionPane}" Margin="0,0,2,0">
                <DockPanel>
<Grid DockPanel.Dock="Top" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="3" Height="11" CornerRadius="2"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Style="{StaticResource RegionTitle}" Text="音频处理" />
                        <Border Grid.Column="2" Height="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource HairlineBrush}" />
                    </Grid>

                    <!-- 覆盖式滚动条：滚动条浮在内容上方、不占布局列，因此出现时不会把卡片挤窄。 -->
                    <ScrollViewer x:Name="LeftScroll" Style="{StaticResource OverlayScrollViewer}" ui:SmoothScroll.Enabled="True" Padding="0,0,0,6">
                        <StackPanel>
                            <!-- 噪声门 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="噪声门" />
                                        <CheckBox x:Name="ToggleGate" Grid.Column="1" Style="{StaticResource Switch}"
                                                  Margin="0,0,8,0" Checked="OnEffectToggled"
                                                  Unchecked="OnEffectToggled"/>
                                        <Button x:Name="ExpandGate" Grid.Column="2"
                                                Style="{StaticResource ExpanderButton}"
                                                Click="OnExpandClick" Tag="{Binding GateExpanded, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <StackPanel x:Name="PanelGate" Visibility="Collapsed" Margin="0,6,0,0">
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="阈值" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="62" />
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="GateThresholdSlider" Grid.Column="0" VerticalAlignment="Center"
                                                        Style="{StaticResource FlatSlider}" Minimum="-80" Maximum="0"
                                                        Value="-55" Tag="GateThreshold" ValueChanged="OnSliderChanged"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource SliderValueText}"
                                                           Text="{Binding Value, ElementName=GateThresholdSlider, StringFormat='{}{0:0} dB'}" />
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                       Text="释放时间" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="62" />
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="GateReleaseSlider" Grid.Column="0" VerticalAlignment="Center"
                                                        Style="{StaticResource FlatSlider}" Minimum="10" Maximum="600"
                                                        Value="150" Tag="GateRelease" ValueChanged="OnSliderChanged"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource SliderValueText}"
                                                           Text="{Binding Value, ElementName=GateReleaseSlider, StringFormat='{}{0:0} ms'}" />
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- AI 降噪 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="AI 降噪" />
                                        <CheckBox x:Name="ToggleDenoise" Grid.Column="1"
                                                  Style="{StaticResource Switch}" Margin="0,0,8,0"
                                                  Checked="OnEffectToggled" Unchecked="OnEffectToggled"/>
                                        <Button x:Name="ExpandDenoise" Grid.Column="2"
                                                Style="{StaticResource ExpanderButton}"
                                                Click="OnExpandClick" Tag="{Binding DenoiseExpanded, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <StackPanel x:Name="PanelDenoise" Visibility="Collapsed" Margin="0,6,0,0">
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="模型" />
                                            <ComboBox x:Name="ModelCombo" Grid.Column="1"
                                                      Style="{StaticResource FlatCombo}"
                                                      ItemContainerStyle="{StaticResource FlatComboItem}"
                                                      DropDownOpened="OnModelDropDownOpened"
                                                      SelectionChanged="OnModelSelectionChanged"/>
                                            <!-- 打开模型文件夹：原先是独立卡片，现挪到模型下拉框右侧，不占额外空间 -->
                                            <Button x:Name="OpenModelsFolderButton" Grid.Column="2"
                                                    Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                                    Click="OnOpenModelsFolderClick">
                                                <Path Data="M 1 3 L 5 3 L 6.5 5 L 13 5 L 13 12 L 1 12 Z"
                                                      Stroke="{DynamicResource IconGlyphBrush}" StrokeThickness="1.3"
                                                      StrokeLineJoin="Round" Fill="Transparent" />
                                            </Button>
                                        </Grid>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                       Text="降噪强度" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="62" />
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="DenoiseStrengthSlider" Grid.Column="0" VerticalAlignment="Center"
                                                        Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                                                        Value="100" Tag="DenoiseStrength" ValueChanged="OnSliderChanged"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource SliderValueText}"
                                                           Text="{Binding Value, ElementName=DenoiseStrengthSlider, StringFormat='{}{0:0}%'}" />
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                       Text="干湿比" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="62" />
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="DenoiseWetSlider" Grid.Column="0" VerticalAlignment="Center"
                                                        Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                                                        Value="100" Tag="DenoiseWet" ValueChanged="OnSliderChanged"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource SliderValueText}"
                                                           Text="{Binding Value, ElementName=DenoiseWetSlider, StringFormat='{}{0:0}%'}" />
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- AI 变声（RVC）：位于 AI 降噪之后、DSP 变声之前。
                                 顺序有硬约束——RVC 对噪声极敏感（必须后于降噪），
                                 且会重新分析输入基频（必须先于 DSP 变调，否则变调被抵消）。
                                 组件（数千 MB）按需安装，放在 data\components\ai\。 -->
                            <Border x:Name="AiVoiceCard" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="AI 变声" />
                                        <CheckBox x:Name="ToggleAiVoice" Grid.Column="1"
                                                  Style="{StaticResource Switch}" Margin="0,0,8,0"
                                                  PreviewMouseLeftButtonDown="OnAiVoiceTogglePreview"
                                                  Checked="OnEffectToggled" Unchecked="OnEffectToggled"/>
                                        <Button x:Name="ExpandAiVoice" Grid.Column="2"
                                                Style="{StaticResource ExpanderButton}"
                                                Click="OnExpandClick" Tag="{Binding AiVoiceExpanded, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <StackPanel x:Name="PanelAiVoice" Visibility="Collapsed" Margin="0,4,0,0">
                                        <Grid x:Name="AiVoiceModelRow" Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="音色" />
                                            <ComboBox x:Name="AiVoiceModelCombo" Grid.Column="1"
                                                      Style="{StaticResource FlatCombo}"
                                                      ItemContainerStyle="{StaticResource FlatComboItem}"
                                                      DropDownOpened="OnAiVoiceModelDropDownOpened"
                                                      SelectionChanged="OnAiVoiceModelSelectionChanged"/>
                                            <Button x:Name="OpenAiVoicesFolderButton" Grid.Column="2"
                                                    Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                                    Click="OnOpenAiVoicesFolderClick">
                                                <Path Data="M 1 3 L 5 3 L 6.5 5 L 13 5 L 13 12 L 1 12 Z"
                                                      Stroke="{DynamicResource IconGlyphBrush}" StrokeThickness="1.3"
                                                      StrokeLineJoin="Round" Fill="Transparent" />
                                            </Button>
                                        </Grid>
                                        <Grid x:Name="AiVoiceIndexRow" Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="索引" />
                                            <ComboBox x:Name="AiVoiceIndexCombo" Grid.Column="1"
                                                      Style="{StaticResource FlatCombo}"
                                                      ItemContainerStyle="{StaticResource FlatComboItem}"
                                                      DropDownOpened="OnAiVoiceIndexDropDownOpened"
                                                      SelectionChanged="OnAiVoiceIndexSelectionChanged"/>
                                            <Button x:Name="OpenAiIndexFolderButton" Grid.Column="2"
                                                    Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                                    Click="OnOpenAiIndexFolderClick">
                                                <Path Data="M 1 3 L 5 3 L 6.5 5 L 13 5 L 13 12 L 1 12 Z"
                                                      Stroke="{DynamicResource IconGlyphBrush}" StrokeThickness="1.3"
                                                      StrokeLineJoin="Round" Fill="Transparent" />
                                            </Button>
                                        </Grid>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="变调" />
                                            <Slider x:Name="AiVoicePitchSlider" Grid.Column="1" VerticalAlignment="Center"
                                                    Style="{StaticResource FlatSlider}" Minimum="-24" Maximum="24"
                                                    Value="0" Tag="AiVoiceSemitones" ValueChanged="OnSliderChanged"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource SliderValueText}"
                                                       Text="{Binding Value, ElementName=AiVoicePitchSlider, StringFormat='{}{0:+0;-0;0} 半音'}" />
                                        </Grid>
                                        <Grid x:Name="AiVoiceIndexRateRow" Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="索引占比" />
                                            <Slider x:Name="AiVoiceIndexRateSlider" Grid.Column="1" VerticalAlignment="Center"
                                                    Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                                                    Value="75" Tag="AiVoiceIndexRate" ValueChanged="OnSliderChanged"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource SliderValueText}"
                                                       Text="{Binding Value, ElementName=AiVoiceIndexRateSlider, StringFormat='{}{0:0}%'}" />
                                        </Grid>
                                        <Grid x:Name="AiVoiceBlockRow" Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="音频块" />
                                            <Slider x:Name="AiVoiceBlockSlider" Grid.Column="1" VerticalAlignment="Center"
                                                    Style="{StaticResource FlatSlider}" Minimum="80" Maximum="500"
                                                    IsSnapToTickEnabled="True" TickFrequency="10"
                                                    Value="250" Tag="AiVoiceBlockMs" ValueChanged="OnAiVoicePerfChanged"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource SliderValueText}"
                                                       Text="{Binding Value, ElementName=AiVoiceBlockSlider, StringFormat='{}{0:0} ms'}" />
                                        </Grid>
                                        <Grid x:Name="AiVoiceContextRow" Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="上下文" />
                                            <Slider x:Name="AiVoiceContextSlider" Grid.Column="1" VerticalAlignment="Center"
                                                    Style="{StaticResource FlatSlider}" Minimum="500" Maximum="3000"
                                                    IsSnapToTickEnabled="True" TickFrequency="50"
                                                    Value="2500" Tag="AiVoiceContextMs" ValueChanged="OnSliderChanged"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource SliderValueText}"
                                                       Text="{Binding Value, ElementName=AiVoiceContextSlider, StringFormat='{}{0:0} ms'}" />
                                        </Grid>
                                        <Grid x:Name="AiVoiceCrossfadeRow" Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="交叉淡化" />
                                            <Slider x:Name="AiVoiceCrossfadeSlider" Grid.Column="1" VerticalAlignment="Center"
                                                    Style="{StaticResource FlatSlider}" Minimum="10" Maximum="40"
                                                    IsSnapToTickEnabled="True" TickFrequency="5"
                                                    Value="40" Tag="AiVoiceCrossfadeMs" ValueChanged="OnSliderChanged"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource SliderValueText}"
                                                       Text="{Binding Value, ElementName=AiVoiceCrossfadeSlider, StringFormat='{}{0:0} ms'}" />
                                        </Grid>
                                        <!-- 输出缓冲：用它在「延迟」与「稳定性」之间取舍。
                                             环里排队的音频就是额外延迟，所以越小越跟手；
                                             但它是"worker 算完这一块之前别被抽干"的余量，
                                             越小越容易欠载（补静音 ⇒ 咔哒）。
                                             ⚠ 下限**刻意放到 0**（2026-10-09 用户要求）：
                                             0 基本不可能稳定输出，但选择权交给用户。 -->
                                        <Grid x:Name="AiVoiceBacklogRow" Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="输出缓冲" />
                                            <Slider x:Name="AiVoiceBacklogSlider" Grid.Column="1" VerticalAlignment="Center"
                                                    Style="{StaticResource FlatSlider}" Minimum="0" Maximum="300"
                                                    IsSnapToTickEnabled="True" TickFrequency="20"
                                                    Value="120" Tag="AiVoiceBacklogPadMs" ValueChanged="OnSliderChanged"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource SliderValueText}"
                                                       Text="{Binding Value, ElementName=AiVoiceBacklogSlider, StringFormat='{}{0:0} ms'}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 变声（DSP）：紧跟 AI 降噪之后。
                                 AI 变声（RVC 组件）已从应用剔除，理由与归档见 项目库\MateMic\归档文档\ -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="DSP 变声" />
                                        <CheckBox x:Name="ToggleVoiceChanger" Grid.Column="1"
                                                  Style="{StaticResource Switch}" Margin="0,0,8,0"
                                                  Checked="OnEffectToggled" Unchecked="OnEffectToggled"/>
                                        <Button x:Name="ExpandVoiceChanger" Grid.Column="2"
                                                Style="{StaticResource ExpanderButton}"
                                                Click="OnExpandClick" Tag="{Binding VoiceChangerExpanded, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <StackPanel x:Name="PanelVoiceChanger" Visibility="Collapsed" Margin="0,6,0,0">
                                        <Grid x:Name="VoicePitchRow" Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="变调" />
                                            <Slider x:Name="VoicePitchSlider" Grid.Column="1" VerticalAlignment="Center"
                                                    Style="{StaticResource FlatSlider}" Minimum="-12" Maximum="12"
                                                    Value="5" Tag="VoiceSemitones" ValueChanged="OnSliderChanged"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource SliderValueText}"
                                                       Text="{Binding Value, ElementName=VoicePitchSlider, StringFormat='{}{0:+0;-0;0} 半音'}" />
                                        </Grid>
                                        <Grid x:Name="VoiceGenderRow" Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="声线" />
                                            <Slider x:Name="VoiceGenderSlider" Grid.Column="1" VerticalAlignment="Center"
                                                    Style="{StaticResource FlatSlider}" Minimum="-100" Maximum="100"
                                                    Value="0" Tag="VoiceGender" ValueChanged="OnSliderChanged" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource SliderValueText}"
                                                       Text="{Binding Value, ElementName=VoiceGenderSlider, StringFormat='{}{0:+0;-0;0}'}" />
                                        </Grid>
                                        <Grid x:Name="VoiceFormantRow" Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="共振峰" />
                                            <Slider x:Name="VoiceFormantSlider" Grid.Column="1" VerticalAlignment="Center"
                                                    Style="{StaticResource FlatSlider}" Minimum="-12" Maximum="12"
                                                    Value="0" Tag="VoiceFormantSemitones" ValueChanged="OnSliderChanged"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource SliderValueText}"
                                                       Text="{Binding Value, ElementName=VoiceFormantSlider, StringFormat='{}{0:+0;-0;0} 半音'}" />
                                        </Grid>
                                        <Grid x:Name="VoiceMixRow" Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="干湿比" />
                                            <Slider x:Name="VoiceMixSlider" Grid.Column="1" VerticalAlignment="Center"
                                                    Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                                                    Value="100" Tag="VoiceMix" ValueChanged="OnSliderChanged"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource SliderValueText}"
                                                       Text="{Binding Value, ElementName=VoiceMixSlider, StringFormat='{}{0:0}%'}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 响度平衡 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}"
                                                   Text="响度平衡" />
                                        <CheckBox x:Name="ToggleLoudness" Grid.Column="1"
                                                  Style="{StaticResource Switch}" Margin="0,0,8,0"
                                                  Checked="OnEffectToggled" Unchecked="OnEffectToggled"/>
                                        <Button x:Name="ExpandLoudness" Grid.Column="2"
                                                Style="{StaticResource ExpanderButton}"
                                                Click="OnExpandClick" Tag="{Binding LoudnessExpanded, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <StackPanel x:Name="PanelLoudness" Visibility="Collapsed" Margin="0,6,0,0">
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                       Text="目标响度" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="62" />
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="LoudnessTargetSlider" Grid.Column="0" VerticalAlignment="Center"
                                                        Style="{StaticResource FlatSlider}" Minimum="-30" Maximum="-8"
                                                        Value="-20" Tag="LoudnessTarget"
                                                        ValueChanged="OnSliderChanged" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource SliderValueText}"
                                                           Text="{Binding Value, ElementName=LoudnessTargetSlider, StringFormat='{}{0:0} dB'}" />
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                       Text="响应速度" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="62" />
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="LoudnessSpeedSlider" Grid.Column="0" VerticalAlignment="Center"
                                                        Style="{StaticResource FlatSlider}" Minimum="1" Maximum="10"
                                                        Value="5" Tag="LoudnessSpeed" ValueChanged="OnSliderChanged" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource SliderValueText}"
                                                           Text="{Binding Value, ElementName=LoudnessSpeedSlider, StringFormat='{}{0:0}/10'}" />
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- EQ 均衡器（原「音色风格」） -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}"
                                                   Text="EQ 均衡器" />
                                        <CheckBox x:Name="ToggleTone" Grid.Column="1"
                                                  Style="{StaticResource Switch}" Margin="0,0,8,0"
                                                  Checked="OnEffectToggled" Unchecked="OnEffectToggled"/>
                                        <Button x:Name="ExpandTone" Grid.Column="2"
                                                Style="{StaticResource ExpanderButton}"
                                                Click="OnExpandClick" Tag="{Binding ToneExpanded, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>

                                    <!--
                                      展开面板：响应曲线 → 10 段推子 → 预设与重置（一整排）。

                                      排布顺序按用户 2026-10-06 的意见调整过：
                                        · 预设 chip 从顶部**移到最下面**，与推子拉开距离 ——
                                          原来它紧贴曲线上边，曲线卡片显得"上面很窄、下面很宽"；
                                        · 原来的「自然」预设删掉，位置换成「重置」按钮 ——
                                          两者作用重合（都是回到平坦响应），
                                          而重置单独占一行放在最底下很突兀。
                                          于是现在是一整排 6 格：5 个预设 + 重置。
                                          （ToneStyle.Natural 枚举值保留：老配置里可能存着它，
                                            删枚举会让反序列化失败；只是界面上不再有入口。）

                                      · 预设与手动推子共用同一份数据（ToneSettings.Gains）：
                                        点预设 = 整表替换成该预设曲线，推子与曲线当场跟着变；
                                        手动拖任一段 = 只改那一段，并取消预设的选中态。
                                      · 10 段推子与频率标签由 BuildEqBands() 在代码里生成 ——
                                        手写 80 行 XAML 不值当，而且代码要按索引持有它们。
                                    -->
                                    <StackPanel x:Name="PanelTone" Visibility="Collapsed" Margin="0,10,0,0">
                                        <!-- 实时响应曲线：拖推子时当场跟着变（10 点折线，x 与推子中心对齐） -->
                                        <Border CornerRadius="6" ClipToBounds="True"
                                                Background="{DynamicResource HeaderSurfaceBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1">
                                            <Canvas x:Name="EqCurveCanvas" Height="46" ClipToBounds="True"
                                                    SizeChanged="OnEqCurveSizeChanged" Background="Transparent"/>
                                        </Border>

                                        <!--
                                          10 段推子（代码填充）。
                                          轨道与"从中线到滑块"的填充条由 EqBarCanvas 画在推子**下层**：
                                          Slider 只提供滑块与交互。这样填充才能从 0 dB 中线往两边长，
                                          而不是像原生 Slider 那样从一端填满 —— 增益有正有负，从一端填会误读
                                          （0 dB 时也会填掉一半，看起来像"已经调过了"）。
                                          高度固定 84，与 EqBandSlider 一致，两层的坐标才对得上。
                                        -->
                                        <Grid Margin="0,9,0,0" Height="84">
                                            <!--
                                              ⚠ EqBarCanvas 必须挂 SizeChanged 重画：
                                              轨道是按 ActualWidth 算出每个推子的横向位置画上去的，
                                              而面板展开、窗口缩放、滚动条出现这些都会改变宽度。
                                              只在展开/拖推子时画一次的话，尺寸一变轨道就还停在按旧宽度
                                              算出来的位置上 —— 每个推子的偏移量还不一样，
                                              看起来就是"有几个滑块的圆点不在轨道正中"。
                                            -->
                                            <Canvas x:Name="EqBarCanvas" ClipToBounds="True" IsHitTestVisible="False"
                                                    SizeChanged="OnEqCurveSizeChanged" />
                                            <UniformGrid x:Name="EqBandGrid" Columns="10" Background="Transparent" />
                                        </Grid>
                                        <UniformGrid x:Name="EqLabelGrid" Columns="10" Margin="0,3,0,0" />

                                        <!-- 5 个预设 + 重置，一排 6 格（重置用同外观的 ChipButton） -->
                                        <UniformGrid x:Name="ToneGrid" Columns="6" Margin="0,11,0,0">
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="清亮" Tag="Bright"
                                                         Click="OnToneSelected"/>
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="沉稳" Tag="Warm"
                                                         Click="OnToneSelected"/>
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="深邃" Tag="Deep"
                                                         Click="OnToneSelected"/>
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="尖锐" Tag="Sharp"
                                                         Click="OnToneSelected"/>
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="空灵" Tag="Ethereal"
                                                         Click="OnToneSelected"/>
                                            <Button x:Name="EqResetButton" Style="{StaticResource ChipButton}"
                                                    Content="重置" Click="OnEqResetClick"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 效果器 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="效果器" />
                                        <CheckBox x:Name="ToggleEffect" Grid.Column="1"
                                                  Style="{StaticResource Switch}" Margin="0,0,8,0"
                                                  Checked="OnEffectToggled" Unchecked="OnEffectToggled"/>
                                        <Button x:Name="ExpandEffect" Grid.Column="2"
                                                Style="{StaticResource ExpanderButton}"
                                                Click="OnExpandClick" Tag="{Binding EffectExpanded, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <StackPanel x:Name="PanelCreative" Visibility="Collapsed" Margin="0,6,0,0">
                                        <UniformGrid x:Name="EffectGrid" Columns="6">
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="混响" Tag="Reverb"
                                                         Margin="0,0,4,4" Click="OnCreativeEffectSelected" />
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="延迟" Tag="Delay"
                                                         Margin="0,0,4,4" Click="OnCreativeEffectSelected" />
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="和声" Tag="Harmony"
                                                         Margin="0,0,4,4" Click="OnCreativeEffectSelected" />
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="电话" Tag="Telephone"
                                                         Margin="0,0,4,4" Click="OnCreativeEffectSelected" />
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="颤音" Tag="Tremolo"
                                                         Margin="0,0,4,4" Click="OnCreativeEffectSelected" />
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="电音" Tag="Robot"
                                                         Margin="0,0,4,4" Click="OnCreativeEffectSelected" />
                                            <RadioButton Style="{StaticResource ChipToggle}" Content="炸麦" Tag="Megaphone"
                                                         Margin="0,0,4,4" Click="OnCreativeEffectSelected" />
                                        </UniformGrid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                       Text="效果强度" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="62" />
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="EffectAmountSlider" Grid.Column="0" VerticalAlignment="Center"
                                                        Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                                                        Value="55" Tag="EffectAmount" ValueChanged="OnSliderChanged"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource SliderValueText}"
                                                           Text="{Binding Value, ElementName=EffectAmountSlider, StringFormat='{}{0:0}%'}" />
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 增益 -->
                            <Border Style="{StaticResource CardLast}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="增益" />
                                        <CheckBox x:Name="ToggleGain" Grid.Column="1" Style="{StaticResource Switch}"
                                                  Margin="0,0,8,0" Checked="OnEffectToggled"
                                                  Unchecked="OnEffectToggled"/>
                                        <Button x:Name="ExpandGain" Grid.Column="2"
                                                Style="{StaticResource ExpanderButton}"
                                                Click="OnExpandClick" Tag="{Binding GainExpanded, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <StackPanel x:Name="PanelGain" Visibility="Collapsed" Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                       Text="增益强度" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="62" />
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="GainSlider" Grid.Column="0" VerticalAlignment="Center"
                                                        Style="{StaticResource FlatSlider}" Minimum="-24" Maximum="24"
                                                        Value="0" Tag="GainDb" ValueChanged="OnSliderChanged"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource SliderValueText}"
                                                           Text="{Binding Value, ElementName=GainSlider, StringFormat='{}{0:+0;-0;0} dB'}" />
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ 中栏：实时频谱 ============ -->
            <Border x:Name="MidRegion" Grid.Column="1" Style="{StaticResource RegionPane}" Margin="0,0,2,0">
                <DockPanel>
<Grid DockPanel.Dock="Top" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="3" Height="11" CornerRadius="2"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Style="{StaticResource RegionTitle}" Text="实时数据" />
                        <Border Grid.Column="2" Height="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource HairlineBrush}" />
                    </Grid>

                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 输入频谱：占上半剩余空间。MinHeight 由 90 降到 55（2026-10-08）：
                                 底部要放"实时数据"卡片，压缩频谱图高度腾出空间。 -->
                            <RowDefinition Height="*" MinHeight="55" />
                            <!-- 输出频谱：占下半剩余空间 -->
                            <RowDefinition Height="*" MinHeight="55" />
                            <!-- RMS 电平条。必须给 MinHeight，否则可用高度不足时
                                 这一行（Auto）会被两张频谱的 * + MinHeight 挤成 0 高而消失
                                 （2026-10-08 用户报"电平调被挡住了"）。刻度 6 + 条 16 + 下边距 2 = 24。 -->
                            <RowDefinition Height="Auto" MinHeight="24" />
                            <!-- 实时数据卡片：延迟与性能消耗 -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                                                                                                <!-- 输入 频谱（2026-10-04 第四次改版）：柱状图 + 对数频率刻度；
                             读数（有效值/峰值）已按反馈删除；画布自带主题底色（修深色模式）。 -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8,5,8,7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="60" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource LabelText}" Text="输入"
                                           FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}" />

                                <!-- 2026-10-04：按反馈去掉频谱的专属底色，直接用卡片底作为背景 -->
                                <Canvas x:Name="InputSpectrumCanvas" Grid.Row="1" ClipToBounds="True" Background="Transparent"/>

                                <!-- 底部频率刻度：对数定位，用 Canvas 精确摆放（Grid 等分列放不准） -->
                                <Canvas x:Name="InputAxisCanvas" Grid.Row="2" Height="14" Margin="0,4,0,0" ClipToBounds="True" />
                            </Grid>
                        </Border>

                                                                                                <!-- 输出 频谱（2026-10-04 第四次改版）：柱状图 + 对数频率刻度；
                             读数（有效值/峰值）已按反馈删除；画布自带主题底色（修深色模式）。 -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,5,8,2" Margin="0,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="60" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource LabelText}" Text="输出"
                                           FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}" />

                                <!-- 2026-10-04：按反馈去掉频谱的专属底色，直接用卡片底作为背景 -->
                                <Canvas x:Name="OutputSpectrumCanvas" Grid.Row="1" ClipToBounds="True" Background="Transparent"/>

                                <!-- 底部频率刻度：对数定位，用 Canvas 精确摆放（Grid 等分列放不准） -->
                                <Canvas x:Name="OutputAxisCanvas" Grid.Row="2" Height="14" Margin="0,4,0,0" ClipToBounds="True" />
                            </Grid>
                        </Border>

                                                                                                <!-- 电平表（2026-10-04 第四次改版）：
                             用户指出这条是**判断音量合不合适的参照尺**（绿=合适、黄=偏大、红=过载），
                             底色固定铺满绿→黄→红，用从右往左的遮罩表示当前电平。

                             圆角修正：上一版给"填充条"和"遮罩"各自设了 RadiusX/RadiusY，
                             两者在交界处各带一半圆角，看起来像"右端向左凹"。现在改为
                             **两个矩形都画满、由外层 Border 的 CornerRadius + ClipToBounds 统一裁边**，
                             右端就只剩外轮廓的圆角了。
                             读数已按反馈删除（把电平条撑长的元凶一并消失）。 -->
                        <!-- ⚠ 上下间距按**可见间距**对齐（2026-10-08 用户第二次指出"上面比下面紧"）。
                             上方可见间距 = 输出频谱卡片底边 → 电平条**彩色条**顶端
                             （中间那 6px 的 dB 刻度画布视觉上也算间距）；
                             下方可见间距 = 彩色条底 → 性能卡片顶。

                             ⚠ 本容器**一律不留底边距**：输出频谱卡片的 Margin 被它自己显式设成 0
                             （覆盖了 Card 样式的 7px），上方裸间隙本来就是 0；而且这个容器每加 1px
                             底边距，`*` 行的重分配会把电平条整体上移约 0.8px
                             （实测 Margin=0 → 上 8.0 / 下 7.2；Margin=1 → 上 7.2 / 下 8.0），
                             等于把间距推到另一侧、白折腾。
                             要对齐的那 1px 改用**性能卡片自己的 Margin.Top** 补（只影响下间距）。 -->
                        <Border Grid.Row="2" Background="Transparent" BorderThickness="0"
                                Margin="0" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- dB 刻度短横线（-48 / -36 / -24 / -12 / 0）：高度收窄，让整块更贴上方卡片 -->
                                <Canvas x:Name="LevelScaleCanvas" Grid.Row="0" Height="6"
                                        VerticalAlignment="Bottom" ClipToBounds="True" />

                                <Border Grid.Row="1" CornerRadius="4" ClipToBounds="True" Height="16">
                                    <Grid x:Name="LevelTrack" Background="Transparent">
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <!-- 左 = 绿（电平低、音量偏小）→ 黄 → 右 = 红（电平高、偏大/过载）。
                                                     2026-10-04：原先左红右绿是反的，已按用户确认的语义调换。 -->
                                                <!-- 左绿 → 黄 → 右红，配额按"合不合适"分档：
                                                     绿 = 到 -18 dBFS（正常说话的区间）、黄 = -18…-6、红 = -6…0（偏大/过载）。
                                                     2026-10-04：原先是把三段配额照搬旧版（红占 45%、绿仅 8%），换方向后就成了"红一大截、绿一点"。 -->
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#5CD65C" Offset="0" />
                                                    <GradientStop Color="#5CD65C" Offset="0.60" />
                                                    <GradientStop Color="#F2C744" Offset="0.70" />
                                                    <GradientStop Color="#F2C744" Offset="0.86" />
                                                    <GradientStop Color="#F26B6B" Offset="0.90" />
                                                    <GradientStop Color="#F26B6B" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <!--
                                          LevelMaskRect：从右往左盖住"高于当前电平"的部分。
                                          Width 由代码设成轨道全宽（只在尺寸变化时才变），遮罩比例靠
                                          ScaleTransform.ScaleX + 原点靠右实现 —— 用变换而不是每帧改 Width，
                                          是为了不触发布局（见 UpdateLevelMeter 的注释）。
                                        -->
                                        <Rectangle x:Name="LevelMaskRect" HorizontalAlignment="Right"
                                                   Width="0" Fill="{DynamicResource LevelMaskBrush}"
                                                   Opacity="0.82" IsHitTestVisible="False"
                                                   RenderTransformOrigin="1,0">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform ScaleX="0" ScaleY="1" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <!--
                                          LevelPeak：峰值保持指针。位置靠 TranslateTransform.X（不再用 Margin）。
                                          原本是 HorizontalAlignment=Left + Margin.Left，两者视觉等价。
                                        -->
                                        <Rectangle x:Name="LevelPeak" Width="2" Height="16"
                                                   Fill="{DynamicResource TextBrush}" Opacity="0.7"
                                                   HorizontalAlignment="Left" IsHitTestVisible="False">
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform X="0" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                            <!--
                              ============ 实时数据卡片（2026-10-08 用户要求）============
                              位置：电平条下方（主体 Grid 的第 3 行）。为它腾空间把两张频谱图的
                              MinHeight 由 90 压到 55。
                              数据由 MainWindow.UpdateRealtimeStats() 按固定频率刷新 —— 这些都是
                              低频变化的量，跟着 30Hz 的频谱刷新只会白耗 CPU。

                              ⚠ 2026-10-08（第二次修）：这张卡片的 `<Border Grid.Row="3">` 原先
                              **写在电平条那个 Border 的内层 Grid 里**，而那个内层 Grid 只定义了 2 行
                              （Row0 刻度 / Row1 电平条）。WPF 对超出范围的行索引会**夹到最后一行**，
                              于是这张卡片与电平条挤在同一格；它声明在后、又是不透明卡片面，
                              就把电平条整条盖住了 —— 用户看到的"电平条被性能卡片挡住"就是这个。
                              （上一轮只给电平条那行加了 MinHeight，治的是"行被压成 0"，
                              没发现真正的重叠。）现在把它放到主体 Grid 的 Row3，
                              那 4 行 RowDefinition 本来就有它的位置。
                            -->
                            <!-- 用 CardLast 而不是 Card：CardLast 的 Margin 是 0,0,0,0（贴底），
                                 与右栏"音频列表"一致；Card 会多出 7px 下间距，两栏底部留白就不齐
                                 （2026-10-08 用户反馈）。上间距由自己的 Margin 给。 -->
                            <Border x:Name="StatsCard" Grid.Row="3" Style="{StaticResource CardLast}"
                                    Padding="8,5,8,7" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource LabelText}" Text="延迟与性能"
                                               FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,5"
                                               Foreground="{DynamicResource TextBrush}" />

                                    <!-- 每行：名称 | 耗时 | 时间占用率 -->
                                    <Grid Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                   Text="AI 降噪" FontSize="11" />
                                        <TextBlock Grid.Column="1" x:Name="StatsDenoiseText"
                                                   Style="{StaticResource LabelText}" FontSize="11" Text="—" />
                                        <TextBlock Grid.Column="2" x:Name="StatsDenoiseLoad"
                                                   Style="{StaticResource LabelText}" FontSize="11" Text=""
                                                   Foreground="{DynamicResource SubtleTextBrush}" />
                                    </Grid>

                                    <Grid Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                   Text="AI 变声" FontSize="11" />
                                        <TextBlock Grid.Column="1" x:Name="StatsAiVoiceText"
                                                   Style="{StaticResource LabelText}" FontSize="11" Text="—" />
                                        <TextBlock Grid.Column="2" x:Name="StatsAiVoiceLoad"
                                                   Style="{StaticResource LabelText}" FontSize="11" Text=""
                                                   Foreground="{DynamicResource SubtleTextBrush}" />
                                    </Grid>

                                    <!-- 资源占用：本进程 CPU 占用 + 显卡整体利用率。
                                         与上面两行同列宽（名称 | 内容 | 右侧）。2026-10-09 用户要求补一行
                                         —— 调「音频块 / 输出缓冲」是在拿延迟换稳定性，得能看见整机还剩多少余量。
                                         GPU 读不到时（非 N 卡 / 驱动没提供 NVML）显示「GPU —」。 -->
                                    <Grid Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                   Text="资源占用" FontSize="11" />
                                        <TextBlock Grid.Column="1" x:Name="StatsCpuText"
                                                   Style="{StaticResource LabelText}" FontSize="11" Text="—" />
                                        <TextBlock Grid.Column="2" x:Name="StatsGpuText"
                                                   Style="{StaticResource LabelText}" FontSize="11" Text=""
                                                   Foreground="{DynamicResource SubtleTextBrush}" />
                                    </Grid>

                                    <Border Height="1" Margin="0,5,0,5"
                                            Background="{DynamicResource HairlineBrush}" />

                                    <!-- 三列，与上面两行对齐：名称 | 构成明细 | 总计（右对齐）。
                                         总计单独列出来右对齐，纵向扫一眼就能比对（2026-10-08 用户要求）。 -->
                                    <Grid Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                                   Text="延迟构成" FontSize="11" />
                                        <TextBlock Grid.Column="1" x:Name="StatsLatencyText"
                                                   Style="{StaticResource LabelText}" FontSize="11"
                                                   Text="—" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" x:Name="StatsLatencyTotal"
                                                   Style="{StaticResource LabelText}" FontSize="11"
                                                   Text="—" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                </DockPanel>
            </Border>

            <!-- ============ 右栏：播放伴奏 / 语音包 ============ -->
            <Border x:Name="RightRegion" Grid.Column="2" Style="{StaticResource RegionPane}">
                <DockPanel>
<Grid DockPanel.Dock="Top" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="3" Height="11" CornerRadius="2"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Style="{StaticResource RegionTitle}" Text="播放音频" />
                        <Border Grid.Column="2" Height="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource HairlineBrush}" />
                    </Grid>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 路由开关 + 音量 -->
                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LabelText}" Text="音频监听" />
                                    <CheckBox x:Name="ToggleAudioMonitor" Style="{StaticResource Switch}"
                                              Margin="6,0,14,0" Checked="OnAudioMonitorToggled"
                                              Unchecked="OnAudioMonitorToggled" />
                                    <TextBlock Style="{StaticResource LabelText}" Text="循环播放" />
                                    <CheckBox x:Name="ToggleLoop" Style="{StaticResource Switch}" Margin="6,0,0,0"
                                              Checked="OnLoopToggled" Unchecked="OnLoopToggled"/>
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="播放音量" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="62" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="PlayerVolumeSlider" Grid.Column="0" VerticalAlignment="Center"
                                                Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                                                Value="80" ValueChanged="OnPlayerVolumeChanged"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource SliderValueText}"
                                                   Text="{Binding Value, ElementName=PlayerVolumeSlider, StringFormat='{}{0:0}%'}" />
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="同步按住键" />
                                    <CheckBox x:Name="ToggleHoldKey" Grid.Column="1" Style="{StaticResource Switch}"
                                              Margin="6,0,10,0" Checked="OnHoldKeyToggled"
                                              Unchecked="OnHoldKeyToggled"
                                              PreviewMouseLeftButtonDown="OnHoldKeyTogglePreview" />
                                    <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="风险说明"
                                            Padding="6,1,6,1" HorizontalAlignment="Left"
                                            Click="OnHoldKeyRiskClick"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="1" Style="{StaticResource FlatButton}" Content="添加音频文件"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="OnAddFilesClick"/>

                        <!-- 音频列表 -->
                        <Border Grid.Row="2" Style="{StaticResource CardLast}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource HeaderSurfaceBrush}"
                                        CornerRadius="7,7,0,0">
                                    <TextBlock Style="{StaticResource LabelText}" Text="音频列表"
                                               HorizontalAlignment="Center" Margin="0,5,0,5" />
                                </Border>

                                <ScrollViewer Grid.Row="1" Style="{StaticResource OverlayScrollViewer}"
                                              ui:SmoothScroll.Enabled="True">
                                    <ItemsControl x:Name="TrackList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:Name="RowRoot" Height="30" Cursor="Hand"
                                                      Background="Transparent"
                                                      MouseLeftButtonUp="OnTrackRowClick">
                                                    <!--
                                                      行的背景由三层叠出来（在同一个 Grid 里重叠，而不是各自设 Background）：
                                                        ① 当前播放项的底色（强调色淡底）；
                                                        ② 播放进度：从左往右填充的条（ProgressBar，轨道透明）；
                                                        ③ 鼠标悬浮高亮（中性淡色）。
                                                      三层各管一件事、互不覆盖 —— 之前只有一层 Background，
                                                      既当「当前项标记」又当「悬浮反馈」，就没地方再放进度了。
                                                      最上面的内容层负责接鼠标事件，所以这三层不必拦鼠标。
                                                    -->
                                                    <Border>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Background"
                                                                                Value="{DynamicResource AccentSoftBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"
                                                                 Style="{StaticResource TrackProgressBar}" />

                                                    <Border>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <!--
                                                                      ⚠ 用**行根元素**的 IsMouseOver 驱动，而不是这一层自己的。
                                                                      这层 Border 与文件名、按钮是**兄弟**关系，它自己的
                                                                      IsMouseOver 只覆盖自己的子树 —— 鼠标一移到文件名上
                                                                      就变成 false、高亮当场灭掉，看起来就是"文件名把那块
                                                                      区域的悬浮反馈挡住了"（用户 2026-10-06 报的问题）。
                                                                      行根是所有内容的祖先，它的 IsMouseOver 在整行范围内都为真。
                                                                    -->
                                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=RowRoot}"
                                                                                 Value="True">
                                                                        <Setter Property="Background"
                                                                                Value="{DynamicResource RowHoverBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <!--
                                                      内容层：整块铺上透明背景。
                                                      TextBlock 只在"字形"上参与命中测试 —— 不铺背景的话，
                                                      行的点击会变成"有字的地方点得动、字旁边的空白点不动"，
                                                      看起来就像文件名把那块区域的选中反应挡住了。
                                                      铺上透明背景后整行是同一个命中目标；
                                                      而且透明背景**不会**遮住下层的高亮与进度。
                                                    -->
                                                    <Grid Background="Transparent">
                                                    <!--
                                                        按键控件的宽度**由内容决定**（绑定到实测文字宽度）：
                                                        TrackViewModel 用 FormattedText 按控件实际字号量出文字宽度再加内边距，
                                                        所以占位符「设快捷键」时只有 ~60 DIP，而长键位
                                                        （例：Ctrl + Alt + Shift + F12 ≈ 136 DIP）也不会被截断。
                                                        Auto 列 + 不打折的 * 列：省下的宽度全归文件名。

                                                        「同步按住键」总开关关着时整个同步键按钮 **Collapsed**，
                                                        不再占位 —— 该功能默认关闭且用得少，留着会一直挤占文件名宽度。
                                                        列数也因此从 5 列减到 4 列（原 2px 间隔列改为按钮自身的左边距）。
                                                    -->
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="26" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Style="{StaticResource LabelText}"
                                                               Text="{Binding DisplayName}" Margin="8,0,4,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1"
                                                            Content="{Binding HotkeyText}"
                                                            Width="{Binding HotkeyButtonWidth}"
                                                            Click="OnTrackHotkeyClick" Tag="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource InputBoxButton}">
                                                                <Style.Triggers>
                                                                    <!-- 未绑定时显示成灰字占位符（像输入框的 placeholder） -->
                                                                    <DataTrigger Binding="{Binding IsHotkeySet}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource PlaceholderBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <!--
                                                        同步按住键按钮：总开关未开启时整块隐藏（Visibility=Collapsed），
                                                        把宽度让给文件名。因此这里不再需要「未启用」的灰字占位状态。
                                                    -->
                                                    <Button Grid.Column="2"
                                                            Content="{Binding HoldKeyText}"
                                                            Width="{Binding HoldKeyButtonWidth}"
                                                            Margin="2,0,0,0"
                                                            IsEnabled="{Binding HoldKeyEnabled}"
                                                            Click="OnTrackHoldKeyClick" Tag="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource InputBoxButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HoldKeyFeatureEnabled}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsHoldKeySet}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource PlaceholderBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Grid.Column="3" Style="{StaticResource RemoveButton}"
                                                            Click="OnTrackRemoveClick" Tag="{Binding}" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 状态条（MIXLINE 提示 / 设备掉线 / 错误） -->
        <Border x:Name="StatusBar" Grid.Row="2" Background="{DynamicResource WarningBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="8"
                Padding="10,6,10,6" Margin="8,6,8,8" VerticalAlignment="Bottom" Visibility="Collapsed"
                Panel.ZIndex="5">
                        <Border.Effect>
                <DynamicResource ResourceKey="TopBarShadow" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Style="{StaticResource LabelText}"
                           Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
                <Button x:Name="StatusActionButton" Grid.Column="1" Style="{StaticResource FlatButton}"
                        Content="查看设置指南" Margin="8,0,0,0" Visibility="Collapsed"
                        Click="OnStatusActionClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
