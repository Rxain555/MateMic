<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <!--
      刻意不设 RuntimeIdentifier：设了会把输出挪到 bin\Debug\net9.0-windows\win-x64\，
      而 Visual Studio 调试时用的启动路径与"直接双击 exe"可能不一致，导致
      数据目录（exe 同级的 data\）被分到两处，表现为"VS 里调试不保存配置"。
      框架依赖构建不需要 RID。
    -->
    <SelfContained>false</SelfContained>
    <!-- exe 图标（同时被资源管理器、任务栏、Alt+Tab 使用） -->
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
    <Version>0.3.4</Version>
    <AssemblyName>MateMic</AssemblyName>
    <RootNamespace>MateMic</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MateMic.Windows\MateMic.Windows.csproj" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="NWaves" Version="0.9.5" />
    <!-- 变声：变调 + 共振峰独立搬移（MIT；自带 win-x64 原生库约 136 KB） -->
    <PackageReference Include="SignalsmithStretch-CS" Version="1.1.2" />
    <!-- 降噪模型（dpdfnet / gtcrn）用的 CPU ONNX 运行时。
         AI 变声曾额外引入 DirectML 版做 GPU 推理；该功能已剔除，故换回 CPU 版。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <!-- tools 目录只放脚本与独立小工具，绝不参与主程序编译（否则里面的顶级语句会抢占入口点） -->
  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Page Remove="tools\**" />
    <Resource Remove="tools\**" />
    <Content Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
  </ItemGroup>

  <!--
    Ui\Theme.Legacy.xaml 是旧版 UI 风格的备份，只作回退用（把 App.xaml 里的主题源
    改回它即可），不参与当前构建：默认的 Page 通配会把 .xaml 编成 BAML，
    这里显式排除，让它保持成一个可直接查看/复制的普通文件。
  -->
  <ItemGroup>
    <Page Remove="Ui\Theme.Legacy.xaml" />
    <None Include="Ui\Theme.Legacy.xaml" />
  </ItemGroup>

  <!-- 图标另存一份到输出目录，方便打包脚本与外部工具取用 -->
  <ItemGroup>
    <None Update="Assets\appicon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\appicon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      总开关音效（开启 / 关闭各一个 wav）。与图标同样以"文件"方式复制到输出目录，
      运行时由 Audio\ToggleSoundPlayer 从 Assets\sounds\ 读取。
      打包脚本会把整个输出目录收进安装包与绿色版，所以 .iss 里无需单独声明。
    -->
    <None Update="Assets\sounds\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    界面字体 MiSans Light（小米，免费商用；见 MiSans 官方 FAQ：可嵌入软件，但需在软件中注明）。
    刻意编成 **Resource**（嵌进程序集）而不是复制成文件：
    字体是界面的一部分，不该跟着 data\ 或用户误删而消失；WPF 用 "/Assets/Fonts/#家族名" 引用。
    默认的 None 通配会把这个 ttf 也当成 None，重复包含会报错，所以先 Remove 再 Include。
  -->
  <ItemGroup>
    <None Remove="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <!--
    使用指南的**内置默认内容**（作者自己写的那份）。
    编成 EmbeddedResource 而不是复制成文件：新用户首次运行时，程序会把它写进
    data\使用指南.txt 当作初始内容；之后用户/作者改的是自己那一份，
    升级覆盖安装也不会被冲掉。打包脚本无需额外处理。
    LogicalName 固定成 ASCII，省得中文文件名在资源名里出幺蛾子。
    （默认的 None 通配会把它也当成 None，重复包含会报错，所以先 Remove 再 Include。）
  -->
  <ItemGroup>
    <None Remove="Assets\使用指南.txt" />
    <EmbeddedResource Include="Assets\使用指南.txt" LogicalName="MateMic.Guide.Default.txt" />
  </ItemGroup>

</Project>
