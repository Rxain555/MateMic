<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ============================================================================
      MateMic 现代主题
      ============================================================================
      设计取向（与旧主题 Theme.Legacy.xaml 的差异，逐条对应改动诉求）：

        旧：用灰色底 + 深色 1px 边框划分"分组容器 → 卡片"两层边界，
            层次靠"描边"表达，视觉上线很多。
        新：拿掉深色边框，改用
              · 亚克力（Acrylic）磨砂窗口背景 → 半透明质感；
              · 卡片浮在背景之上，用柔和投影表达层次（Elevation）；
              · 卡片顶部一条 1px 高光，模拟"受光"的物理感；
              · 控件统一大圆角 + 更柔和的灰阶 + 悬浮微抬升。

      ⚠ 回退方式：把 App.xaml 里的 Ui/Theme.Modern.xaml 改回 Ui/Theme.Legacy.xaml 即可
        （两套主题的资源键完全一致，窗口 XAML 不需要动）。
      ============================================================================
    -->

    <!-- ============================ 调色板 ============================ -->
    <Color x:Key="AccentColor">#2F7DF6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#2F7DF6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D6AE6" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#175BC9" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F1FE" />
    <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#D8E7FD" />

    <!--
      窗口本体保持完全透明：亚克力材质由 DWM 在窗口背后合成，
      只要 WPF 这一层不画不透明底，磨砂效果就能透出来。
      若系统不支持亚克力，WindowEffects 会把下面 Acrylic* 画刷换成不透明色。
    -->
    <SolidColorBrush x:Key="WindowBrush" Color="Transparent" />

    <!--
      亚克力可控画刷。默认值 = 支持亚克力时的观感（偏白、只带一点透明），
      运行时由 Ui/ThemeManager.cs 的 Apply() 按"材质是否生效 + 深色还是浅色"改写。
      ⚠ 这里刻意保持很白：用户明确要的是"白 / 浅灰"，不是灰玻璃。
    -->
    <SolidColorBrush x:Key="AcrylicWindowTintBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="AcrylicTopBarBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="AcrylicGroupBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="AcrylicCardBrush" Color="#FFFFFFFF" />

    <!-- 语义色（与亚克力、深浅模式一起被 Ui/ThemeManager.cs 改写） -->
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RowAltBrush" Color="#0FFFFFFF" />

    <!--
      窗口底色：**纯色**。
      之前这里用的是一层径向渐变（左上亮、右下暗）+ 卡片的上下渐变，
      实际观感被反馈为"深灰太多、渐变很怪"，因此全部改成纯色。
      层次现在只由"白卡片 + 浅灰底 + 柔和投影"表达，不再靠渐变。
    -->
    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#F5F6F8" />

    <!-- 兼容别名：卡片底色统一走 CardBrush（纯白），保留这个键名是为了不改窗口 XAML -->
    <SolidColorBrush x:Key="CardGradientBrush" Color="#FFFFFFFF" />

    <!-- 分组容器顶部的一条高光（1px 纯色） -->
    <SolidColorBrush x:Key="GroupHighlightBrush" Color="#59FFFFFF" />

    <!-- 组内小标题用的浅色分隔底（音频列表表头等） -->
    <SolidColorBrush x:Key="HeaderSurfaceBrush" Color="#FAFBFC" />

    <!-- 边框：极浅的中性灰，只用于收边，不承担层级区分 -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#16000000" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#12000000" />
    <SolidColorBrush x:Key="GroupBorderBrush" Color="#0D000000" />
    <!-- 三栏分区底：比窗口底色只深一点点，用来替代原来的"分组容器外壳"（层级减负） -->
    <SolidColorBrush x:Key="RegionBackgroundBrush" Color="#07000000" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#18000000" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#2A000000" />

    <SolidColorBrush x:Key="TextBrush" Color="#1C1E22" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#636A76" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#AAB0BA" />
    <SolidColorBrush x:Key="ChipBrush" Color="#E9ECF0" />
    <SolidColorBrush x:Key="ChipSelectedBrush" Color="#2F7DF6" />

    <!--
      控件面（按钮 / 输入框 / 下拉框）用浅灰 #EEF0F3。
      原来是纯白——在白色卡片上等于没有边界，用户反馈"颜色太浅、区分度不够"。
      这里给一个比卡片略深的浅灰，再配合投影就能有明确的"可点"观感。
    -->
    <SolidColorBrush x:Key="ControlBrush" Color="#EEF0F3" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#E2E6EC" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#D4DAE3" />
    <!-- 滑轨很浅：原来是 #1F000000（偏深的灰），用户反馈"深灰太多" -->
    <SolidColorBrush x:Key="TrackBrush" Color="#E7EAEF" />
    <!-- 滚动条滑块：浅灰，别在白色卡片上拉出一条黑线 -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C6CBD3" />

    <!-- 状态条（提示/警告） -->
    <SolidColorBrush x:Key="WarningBrush" Color="#F2FFF8E1" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#4DE0B93C" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#6B5400" />

    <!--
      ============================================================================
      以下键供 ThemeManager 换肤使用（深色模式会覆写它们）。
      ⚠ 这里的值必须与 Ui/ThemeManager.cs 里的 Light() 保持一致——
        本文件提供的是"ThemeManager 运行之前"的浅色默认值。
      ============================================================================
    -->
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="PrimaryDisabledBrush" Color="#4D9AA3B2" />
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#FFD2D7DE" />
    <SolidColorBrush x:Key="SwitchTrackBrush" Color="#D8DCE2" />
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InputBoxBrush" Color="#EDF0F4" />
    <SolidColorBrush x:Key="InputBoxDisabledBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="SliderFillBrush" Color="#4C93F5" />
    <SolidColorBrush x:Key="ComboArrowBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="ExpanderArrowBrush" Color="#8A93A3" />
    <SolidColorBrush x:Key="RemoveGlyphBrush" Color="#9AA3B0" />
    <SolidColorBrush x:Key="IconGlyphBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="CaptionGlyphBrush" Color="#4A4F57" />
    <SolidColorBrush x:Key="CaptionGlyphHoverBrush" Color="#1C1E22" />
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="CaptionPressedBrush" Color="#24000000" />
    <SolidColorBrush x:Key="SpectrumSlotBrush" Color="#E6E9EE" />
    <SolidColorBrush x:Key="LevelNeedleBrush" Color="#2F2F2F" />

    <!-- ============================ 阴影（用层次代替边框） ============================ -->
    <!-- 卡片：淡淡的低位投影。颜色用中性灰而不是蓝灰，避免在白色卡片下发青发脏 -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="1.5" Direction="270"
                      Color="#FF7A8290" Opacity="0.13" RenderingBias="Quality" />
    <!-- 悬浮元素（按钮/下拉框）：更小的投影 -->
    <DropShadowEffect x:Key="ControlShadow" BlurRadius="6" ShadowDepth="1" Direction="270"
                      Color="#FF7A8290" Opacity="0.12" RenderingBias="Quality" />
    <!-- 顶栏：把内容区"压"在下面 -->
    <DropShadowEffect x:Key="TopBarShadow" BlurRadius="16" ShadowDepth="3" Direction="270"
                      Color="#FF7A8290" Opacity="0.14" RenderingBias="Quality" />

    <!--
      ============================ 悬浮说明框（ToolTip） ============================
      隐式样式，所有带 ToolTip 的控件自动套用，不需要逐个设置。

      · 系统默认的 ToolTip 是方角 + 系统配色 + 系统字体，和自绘界面完全不搭；
        这里换成「淡色圆角框 + 主题配色 + MiSans」，与卡片观感一致。
      · **字体必须显式给**：ToolTip 是独立的弹出层，不会继承窗口的 FontFamily。
      · 文字用 TextBrush 而不是 SmallText 那种 SubtleTextBrush —— 说明文字普遍较长，
        在淡底上要保证可读性。
      · 内容一律按纯文本渲染（TextBlock + TemplateBinding），这样才控制得住
        自动换行与行高；本程序所有 ToolTip 都是字符串，没有富内容。
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalOffset" Value="10" />
        <Setter Property="VerticalOffset" Value="8" />
        <!-- 说明动辄四五句，限宽避免拉成一整条横线（与 DialogHost 对长文案的处理一致） -->
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <!--
                      内边距刻意给得比卡片小：提示框本身尺寸小，四周留 10/6 就已经"透气"，
                      给大了会让文字显得缩在中间、框也显空（用户 2026-10-06 反馈）。
                      **不设 LineHeight**：之前写死 19（远大于 12 号字的自然行高），
                      多出来的行距在下方累积，视觉上文字偏上、下方留白明显更多，
                      看着就像"没有垂直居中"。用字体自然行高即可。
                    -->
                    <Border Background="{DynamicResource TooltipSurfaceBrush}"
                            BorderBrush="{DynamicResource TooltipBorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="10,6">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextWrapping="Wrap" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 文本 ============================ -->
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SmallText" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ColumnTitle" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,3,0,5" />
    </Style>

    <Style x:Key="GroupTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1,0,7" />
    </Style>

    <!--
      分区标题（2026-10-04 新增）：替代原来的"分组容器外壳"来区分三栏。
      左侧一道 3px 强调色短竖条 + 文字，比给整栏套一个带边框的容器轻得多，
      层级也从"容器 → 卡片"压到"标题 → 卡片"。
    -->
    <Style x:Key="RegionTitle" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="7,0,0,0" />
    </Style>

    <!--
      分区容器：**完全透明**，不加底色、不加边框、不加阴影。
      分区感完全由栏标题（强调色短竖条 + 标题 + 右侧发丝通栏线）承担 —— 层级降到最低。
      （2026-10-04：原先给了一层 #07000000 的极淡底，用户认为不需要，已去掉。）
    -->
    <Style x:Key="RegionPane" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <!--
          左右内边距 2026-10-04 从 8 收到 4：卡片间距 = 栏间 Margin(2) + 左右内边距(4+4) = 10，
          与"距窗口边缘 = Grid Margin(6) + 内边距(4) = 10"相等，三栏的留白一致。
          底部 2026-10-05 从 8 收到 4：卡片底缘到窗口底边的距离也应对齐同一个 10，
          原来 8 会让底部比右侧宽一截（用户反馈"低边框距离卡片底边框有点远"）。
        -->
        <Setter Property="Padding" Value="4,7,4,4" />
    </Style>

    <!-- ============================ 两层结构：分组容器 → 功能卡片 ============================ -->

    <!--
      第 1 层：分组容器。旧主题是"灰底 + 深色边框"；这里换成几乎透明的玻璃面，
      只在需要收边的地方留一条极浅的发丝线，让卡片自己用阴影浮起来。
    -->
    <Style x:Key="GroupContainer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AcrylicGroupBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GroupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,6,8,8" />
    </Style>

    <!--
      第 2 层：功能卡片。层次由「投影 + 比背景略亮的面 + 发丝级边框」表达。
      2026-10-04：先按"层级减负"去掉过投影，后按反馈**加回来** —— 现在层级只有两层
      （分区容器已透明），所以卡片投影不会再有"三层叠在一起"的厚重感，反而给出需要的悬浮感。
    -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
        <!-- 纯白卡片（原来是上下渐变，已按反馈去掉） -->
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="10,8,10,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 紧贴分组容器底部的最后一张卡：不再叠加下间距 -->
    <Style x:Key="CardLast" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <!-- ============================ 滑块 ============================ -->
    <!--
  界面字体：MiSans Light（小米，免费商用）以 WPF 资源方式嵌在程序集里，
  URI 里的 #MiSans Light 是字体内部的家族名（不是文件名）。
  末尾带上系统字体作为兜底：万一资源没加载成功，界面也不会变成默认宋体。
-->
<FontFamily x:Key="AppFont">/Assets/Fonts/#MiSans Light, Microsoft YaHei UI, Segoe UI</FontFamily>

<!-- 滑条右侧的数值：等宽数字 + 右对齐 + 固定列宽，拖动时数字不会左右跳动 -->
<Style x:Key="SliderValueText" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
  <Setter Property="VerticalAlignment" Value="Center" />
  <Setter Property="HorizontalAlignment" Value="Right" />
  <Setter Property="TextAlignment" Value="Right" />
  <Setter Property="Margin" Value="8,0,0,0" />
  <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
</Style>
<Style x:Key="FlatSlider" TargetType="Slider">
        <!--
          高度与 FlatCombo / IconButton 对齐（都是 26）。
          原先滑条是 20，导致"有滑条的行"比"有下拉框/按钮的行"矮 6px，
          同一张卡片里两种行高交替出现，观感不整齐（2026-10-07 用户指出，且不止 AI 变声模块）。
          EQ 均衡器用的是另一套竖向推子样式，不受这里影响。
        -->
        <Setter Property="Height" Value="26" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="5" CornerRadius="2.5" Background="{DynamicResource TrackBrush}"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <!-- 已填充部分：纯色，不用渐变（渐变观感已被反馈为不佳） -->
                                            <Border Height="5" CornerRadius="2.5" VerticalAlignment="Center"
                                                    Background="{DynamicResource SliderFillBrush}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" Height="5" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Fill="White" Width="14" Height="14">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="5" ShadowDepth="1"
                                                                          Direction="270" Color="#FF7A8290"
                                                                          Opacity="0.35" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <Ellipse Width="14" Height="14" Stroke="{DynamicResource AccentBrush}"
                                                         StrokeThickness="2" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!--
          禁用态：整个滑条降到 40% 不透明度。
          ⚠ 原先没写这一条，导致控件其实已经 IsEnabled=false、但**看上去毫无变化**
          （下拉框有系统默认的禁用外观，而滑条用的是自定义模板，禁用时什么都不变）。
          2026-10-08 用户反馈"除了模型选择和索引选择下拉框是灰的，其他东西都没变灰"就是这个原因。
          注意：Style.Triggers 必须放在所有 Setter 之后，否则 XAML 编译报 MC3088。
        -->
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
      EQ 均衡器的竖向推子。与 FlatSlider 同一套观感（白底强调色描边的圆点）。

      ⚠ **本模板不画轨道，也不画填充**：两者都由 MainWindow 的 EqBarCanvas 画在推子下层。
        原因是填充必须"从 0 dB 中线往两边长"，而原生 Slider 的 RepeatButton 只能从一端填；
        增益有正有负时，从一端填会让人误读（0 dB 也会填掉一半）。
        所以这里只保留一个透明的 Track（提供滑块定位与命中范围）和滑块本身。

      垂直方向默认就是"上大下小"，与图形均衡器的直觉一致，不需要 IsDirectionReversed。
      Height 必须与 XAML 里推子区 Grid 的高度（84）一致，否则填充条与滑块对不上。
    -->
    <Style x:Key="EqBandSlider" TargetType="Slider">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Height" Value="84" />
        <Setter Property="Width" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid HorizontalAlignment="Center">
                        <Track x:Name="PART_Track" Orientation="Vertical">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" Width="20" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" Width="20" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Fill="White" Width="14" Height="14">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="5" ShadowDepth="1"
                                                                          Direction="270" Color="#FF7A8290"
                                                                          Opacity="0.35" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <Ellipse Width="14" Height="14" Stroke="{DynamicResource AccentBrush}"
                                                         StrokeThickness="2" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      播放列表行背景用的播放进度条：只画"已经播过"的那一段（从左往右），轨道透明。
      同一行的背景还叠着「当前播放项底色」与「鼠标悬浮高亮」两层，
      三者职责不同、互不干扰（见 MainWindow.xaml 里行模板的注释）。
    -->
    <Style x:Key="TrackProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="Transparent" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                Background="{DynamicResource AccentSoftHoverBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 按钮 ============================ -->
    <!-- 基础按钮：无边框、扁平、悬浮时轻微"抬升"（投影 + 背景变亮） -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="13,4,13,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 外层只画投影、内层画圆角填充：避免阴影的方形底子从圆角外露出来 -->
                    <Border x:Name="Shadow" CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                              Color="#FF7A8290" Opacity="0.20" />
                        </Border.Effect>
                        <Border x:Name="Bd" Background="{DynamicResource ControlBrush}" BorderThickness="0"
                                CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                            <Setter TargetName="Shadow" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlDisabledBrush}" />
                            <Setter TargetName="Shadow" Property="Effect" Value="{x:Null}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Padding" Value="10,3,10,3" />
        <!-- 文字超长时裁剪而不是换行，避免工具栏高度被内容顶下去 -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 同样拆两层：投影在外、填充在内 -->
                    <Border x:Name="Shadow" CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                              Color="#FF7A8290" Opacity="0.20" />
                        </Border.Effect>
                        <Border x:Name="Bd" Background="{DynamicResource ControlBrush}" BorderThickness="0"
                                CornerRadius="6" Padding="{TemplateBinding Padding}" ClipToBounds="True"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                            <Setter TargetName="Shadow" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlDisabledBrush}" />
                            <Setter TargetName="Shadow" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主行动按钮（例如"训练模型"） -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource AccentBrush}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Direction="270"
                                              Color="#FF2F7DF6" Opacity="0.34" />
                        </Border.Effect>
                        <TextBlock Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryDisabledBrush}" />
                            <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      总开关：胶囊滑块开关（2026-10-04 加动画）。
      滑块用 TranslateTransform 平移（原来是改 HorizontalAlignment，那个属性无法动画）。
      轨道换色仍走 Trigger 的 DynamicResource：主题色是动态资源，用 ColorAnimation 写死颜色
      会在深浅模式切换时割裂，所以只动滑块、不动颜色曲线。
    -->
    <ControlTemplate x:Key="SwitchTemplate" TargetType="CheckBox">
        <Grid Width="38" Height="20">
            <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource SwitchTrackBrush}" />
            <!--
              加载进度填充层（方案 02「轨道进度条」）。
              **宽度恒为轨道全长 38，靠 Clip 从左揭示**：
              若改用"改宽度"，进度小时圆角画不出来会变成一条竖线，稍大一点又是一个椭圆
              （两种都被用户看到过）。固定宽度 + 裁剪则圆角始终是轨道的圆角，形状永不变形。
            -->
            <Border x:Name="ProgressFill" CornerRadius="10" Width="38"
                    HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                    Visibility="Collapsed">
                <Border.Clip>
                    <RectangleGeometry x:Name="ProgressClip" Rect="0,0,0,20" />
                </Border.Clip>
            </Border>            <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8" Background="White"
                    HorizontalAlignment="Left" Margin="2,0,0,0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="KnobShift" X="0" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270"
                                      Color="#FF7A8290" Opacity="0.3" />
                </Border.Effect>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <!--
                              0.3s + BackEase(Amplitude 0.4)：对应网页设计稿里的
                              cubic-bezier(.34, 1.4, .64, 1) —— 到位时**轻微过冲再回落**，
                              比原来的纯 EaseOut(0.15s) 更有"弹性"、也更从容
                              （2026-10-07 用户要求全项目采用这个速度与回弹）。
                            -->
                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                             To="18" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                             To="0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <!--
              加载进度由代码直接驱动（MainWindow.UpdateAiVoiceLoading 用 Template.FindName
              取到 ProgressFill，再按真实百分比做 150ms 补间）。
              **刻意不用 Style Trigger**：Tag 是 object，布尔与字符串比较在不同时序下不可靠，
              最初那版 `Tag=True` 的 Trigger 就没有生效（2026-10-07 用户反馈"加载条没生效"）。
            -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.4" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Template" Value="{StaticResource SwitchTemplate}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ============================ 开关 + 文字 ============================ -->
    <Style x:Key="SwitchWithText" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="38" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource SwitchTrackBrush}" />
                            <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8" Background="White"
                                    HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="Caption" Text="{TemplateBinding Content}" Margin="7,0,0,0"
                                   FontFamily="{DynamicResource AppFont}" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="18" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource DisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      ============================ chip 外观（单选 / 命令按钮共用） ============================

      chip 这个词在本项目指"一排等宽的小方块按钮"：效果器与 EQ 的预设选择，
      以及紧随其后的命令按钮（如 EQ 的「重置」）。

      外观只写这一份：模板 <see> 与度量样式 ChipLook </see>。
        · ChipToggle —— 表示选中态（RadioButton），如「清亮 / 沉稳 / …」；
        · ChipButton —— 纯命令（Button），如「重置」。
      两者只差"有没有选中态"这一件事，所以共享模板与度量：
      **加新的同类按钮时只要 BasedOn ChipLook，不必再抄一遍尺寸和外观。**

      选中态为什么能在 Style 层做：模板里的底与文字用的是
      `{TemplateBinding Background}` / `{TemplateBinding Foreground}`，
      于是 Style 的 Trigger 直接改这两个属性就能穿透到模板内部，
      不需要为每个状态在模板里写一份 TargetName。
    -->
    <ControlTemplate x:Key="ChipTemplate" TargetType="ButtonBase">
        <!-- 阴影与填充分两层，避免圆角外露出方形阴影底 -->
        <Border x:Name="Shadow" CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270"
                                  Color="#FF7A8290" Opacity="0.16" />
            </Border.Effect>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="7,4,7,4" SnapsToDevicePixels="True">
                <ContentPresenter x:Name="Txt" Content="{TemplateBinding Content}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlDisabledBrush}" />
                <Setter TargetName="Shadow" Property="Effect" Value="{x:Null}" />
                <Setter TargetName="Txt" Property="TextElement.Foreground"
                        Value="{DynamicResource DisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ChipLook" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource ChipTemplate}" />
    </Style>

    <!-- 单选小按钮（效果器预设 / EQ 预设）：选中态用强调色实底 + 白字 -->
    <Style x:Key="ChipToggle" TargetType="RadioButton" BasedOn="{StaticResource ChipLook}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ChipSelectedBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 同排的命令按钮（EQ 的「重置」）：外观与 chip 完全一致，只是没有选中态 -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource ChipLook}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ 下拉框 ============================ -->
    <Style x:Key="FlatCombo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!--
                          阴影与填充必须分成两个 Border。
                          根因：DropShadowEffect 是画在元素自身上的，阴影形状来自"元素轮廓的模糊"，
                          但它渲染出来的底子是一个**方形**的模糊矩形。把它直接加在带圆角的
                          Border 上，圆角外面就会露出方形的阴影边——看起来就是"圆角 + 方角两层"。
                          拆开之后：外层只负责投影、本身不画任何东西，内层画圆角白底把中心盖实，
                          于是只剩一圈柔和的圆角光晕。
                        -->
                        <Border x:Name="BdShadow" CornerRadius="6" Margin="0,1,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                                  Color="#FF7A8290" Opacity="0.14" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Bd" Background="{DynamicResource ControlBrush}" BorderThickness="0"
                                CornerRadius="6" SnapsToDevicePixels="True" />
                        <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0" Focusable="False"
                                      ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="9,0,24,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False" />
                        <!-- 箭头不参与命中测试，否则点它不会展开下拉框。
                             2026-10-04 与模块展开按钮统一为同一套方向约定：
                             **基线几何 = 朝下的 v，0° = 朝下（展开态）、+90° = 朝左（收起态）**。
                             收起态是 +90°，所以静态观感不依赖动画是否跑过。 -->
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Center"
                              Width="12" Height="12" Margin="0,0,8,0" IsHitTestVisible="False">
                            <Path x:Name="Arrow" Data="M 1 3 L 6 8 L 11 3" Stroke="{DynamicResource ComboArrowBrush}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <!-- 初始即收起态（+90° = 朝左），展开时动画回 0°（朝下） -->
                                    <RotateTransform x:Name="ComboArrowRotation" Angle="90" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                               PopupAnimation="Fade">
                            <!-- 同样拆两层：外层投影 + 内层不透明圆角填充。
                                 内层必须**不透明**，否则阴影会从底下透上来，又变成两层背景。 -->
                            <Grid MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0">
                                <Border CornerRadius="8" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                                          Color="#FF7A8290" Opacity="0.26" />
                                    </Border.Effect>
                                </Border>
                                <Border Background="{DynamicResource PopupSurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" MaxHeight="260"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="3,4,3,4">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                        <!-- 收起 = +90° 朝左；展开 = 0° 朝下（与模块展开按钮一致） -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ComboArrowRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ComboArrowRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         To="90" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 小图标按钮：用于下拉框旁的操作入口（如打开模型文件夹） -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource ControlBrush}" BorderThickness="0"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlatComboItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="9,5,9,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="3,1,3,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftHoverBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 折叠箭头按钮 ============================ -->
    <!--
      用「两个几何图形 + DataTrigger」而不是旋转：旋转的命名对象在模板里不易可靠取到，
      而且这里只有两种朝向，直接切换 Data 更直观、也不会出现朝上/朝右这类错向。
      Button.Tag 绑定窗口上的布尔属性（如 GateExpanded）：True = 展开（朝下），False = 收起（朝左）。
    -->
    <Style x:Key="ExpanderButton" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                        <Grid>
                            <!--
                              折叠/展开箭头（2026-10-04 第三次修正：统一为"展开朝下、收起朝左"）。

                              ⚠ 方向约定（这份注释是唯一权威，别再靠脑内推演旋转方向）：
                                基线几何 = **朝下的 v**（`M 0 1 L 5 6 L 10 1`）；
                                **Angle 0° = 朝下（展开态）**，**Angle +90° = 朝左（收起态）**。
                                正角是顺时针：朝下的 v 顺时针转 90° 变成朝左的 <。
                                （几何表：基线在 0°=下 / +90°=左 / −90°=右 / 180°=上。）

                              ⚠ 为什么让"展开态"等于基线：即使动画没跑（例如启动时被绑定直接赋值），
                              静态观感依然正确，不依赖动画是否播放过。
                            -->
                            <Path x:Name="Arrow" Data="M 0 1 L 5 6 L 10 1" Stroke="{DynamicResource ExpanderArrowBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <!-- 初始即收起态（+90° = 朝左），展开时动画回 0°（朝下） -->
                                    <RotateTransform x:Name="ArrowRotation" Angle="90" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArrowRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArrowRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         To="90" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipBrush}" />
                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      工具栏第二行的三个设备下拉框。基于 FlatCombo 加宽，让设备名尽量显示完整
      （原来固定 98 DIP，"扬声器 (MIXLINE)" 这类名字只能看到一半）。
      MinWidth 而不是 Width：窗口宽度固定，三组"标签 + 框"用等宽星号列均匀铺满整行。
    -->
    <Style x:Key="DeviceCombo" TargetType="ComboBox" BasedOn="{StaticResource FlatCombo}">
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Height" Value="27" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- 音频列表行 -->
    <Style x:Key="TrackRowButton" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      列表行里的按键控件：「设快捷键 / 设同步键」。
      外观做成和工具栏按钮一致的圆角小框，而不是普通按钮——
      这样一行里放两个也不挤，也不会把文件名挤掉。
      禁用（「同步按住键」总开关未打开）时依然保留 hover 反馈，只是更淡，
      否则用户会以为控件坏了、连点都点不动。
    -->
    <!--
      ============================ 行内小控件基准 ============================

      凡是"排在列表行 / 参数行里的小控件"（快捷键按钮、同步键按钮、✕ 移除按钮，
      以及以后新增的同类控件）都基于这一个样式，只在这里定义一次尺寸与对齐：

        · **高度固定**，不再让各自的内边距/外边距去凑 —— 之前 ✕ 按钮没有 Margin，
          它的悬停色块会撑满整行 30px，而快捷键按钮是 Margin 1,3,1,3 的 23px，
          同一行里两个控件高矮不一（用户 2026-10-06 反馈）。
        · 垂直居中：行高变化时不会一个贴顶一个贴底。
        · 字号与字体也在这里定，避免各处写不同值。

      工具栏按钮（FlatButton / ToolbarButton）、chip、标题栏按钮**不并入**这套：
      它们的用途与观感要求不同（有投影、有选中态、要贴合标题栏几何），
      强行合并只会互相牵制。这里统一的是"行内小控件"这一层。
    -->
    <Style x:Key="InlineControl" TargetType="Control">
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <!--
          焦点必须不落在它上面，否则点一下之后系统输入法（IME）会把这里当成文本输入目标，
          中文输入法会被唤起来、按键也录不进去（用户反馈必须切英文输入法才能录入）。
        -->
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="InputBoxButton" TargetType="Button" BasedOn="{StaticResource InlineControl}">
        <!--
          它是"看起来像输入框的按钮"，不是真的文本输入框。
          左右各留 1：列宽已经按实测文字宽度算好，多留的每一点都从文件名那里抢；
          上下为 0 —— 高度由 InlineControl 统一给，不再用外边距凑高矮。
        -->
        <Setter Property="Margin" Value="1,0,1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource InputBoxBrush}" BorderThickness="0"
                            CornerRadius="5" Padding="5,1,5,1" SnapsToDevicePixels="True">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBoxDisabledBrush}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            <Setter TargetName="Label" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      移除按钮：内容用几何图形绘制，避免依赖字体里的 ✕ 字形。
      与 InputBoxButton 同高同对齐（都来自 InlineControl）—— 之前它没有外边距，
      悬停色块会撑满整行高度，同一行里比快捷键按钮高出一截。
      宽度也钉死，这样悬停色块是个 22×22 的方块，不会随列宽拉伸。
    -->
    <Style x:Key="RemoveButton" TargetType="Button" BasedOn="{StaticResource InlineControl}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                        <Path x:Name="Cross" Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="{DynamicResource RemoveGlyphBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26E5484D" />
                            <Setter TargetName="Cross" Property="Stroke" Value="#D64545" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#40E5484D" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 自绘标题栏按钮 ============================ -->
    <!--
      标题栏由我们自己画（见 MainWindow.xaml 的 WindowChrome 注释），因此这两个按钮也要自绘。
      尺寸按 Windows 惯例：45×32，无边框透明底，悬停才出现浅色块。
      内容用 "min" / "close" 字符串标识，真正的图形在模板里用 Path 画，
      避免依赖字体里是否有 ✕ / – 字形（与主题里其它图形按钮的做法一致）。
    -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <Path x:Name="Glyph" Data="M 0 5 L 10 5" Stroke="{DynamicResource CaptionGlyphBrush}" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource CaptionGlyphHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <Path x:Name="Glyph" Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{DynamicResource CaptionGlyphBrush}"
                              StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 关闭按钮悬停用系统惯例的红色，用户一眼就知道这是关闭 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E5484D" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C93B40" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 滚动条（细圆角，融入浅色卡片） ============================ -->
    <!--
      覆盖式滚动条（Overlay）：滚动条**浮在内容上方**，不占布局列。
      WPF 自带模板里滚动条是单独一列，Auto 模式一旦出现就会把内容挤窄 ——
      这就是"元素超出区域时列表向左挤一下"的来源（2026-10-03 用户反馈）。
      这里把 ScrollContentPresenter 与 ScrollBar 放在同一个 Grid 单元格里，
      滚动条用 HorizontalAlignment=Right 叠在上面，因此内容宽度恒定不动。
    -->
    <Style x:Key="OverlayScrollViewer" TargetType="ScrollViewer">
        <!-- 像素级滚动：配合滚轮平滑动画，否则按项滚动会一格一跳 -->
        <Setter Property="CanContentScroll" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3" Margin="2,0,2,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      滚动条（现代做法，参考 VS Code / macOS 的覆盖式滚动条）：
        · **常显 8px、压在内容上**是上一版的问题 —— 会盖住卡片右侧的文字和展开按钮；
        · 现在改成：命中区域 12px（好抓）＋ 可见滑块只有 5px（细）＋ 平时完全透明、
          鼠标进入滚动区域才淡入（滚轮滚动时鼠标必然在区域内，所以滚动时一定可见）；
        · 内容侧留固定 12px 边距（见 MainWindow 的 OverlayScrollViewer 用法），
          因此滑块永远落在留白里，不会压到任何文字或按钮，内容也不会被挤动。
    -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Width="5" HorizontalAlignment="Center"
                                                    Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3" />
                                            <ControlTemplate.Triggers>
                                                <!-- 抓住时变粗一点，给一点"被按住"的反馈 -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Width" Value="7" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bar" Property="Width" Value="7" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="12" />
                            <Setter Property="Width" Value="Auto" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 电平条的"未达到"遮罩色（跟着卡片面走，避免挡出一块死白） -->
    <SolidColorBrush x:Key="LevelMaskBrush" Color="#24FFFFFF" />

</ResourceDictionary>
