<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ============================================================================
      MateMic 现代主题
      ============================================================================
      设计取向（与旧主题 Theme.Legacy.xaml 的差异，逐条对应改动诉求）：

        旧：用灰色底 + 深色 1px 边框划分"分组容器 → 卡片"两层边界，
            层次靠"描边"表达，视觉上线很多。
        新：拿掉深色边框，改用
              · 亚克力（Acrylic）磨砂窗口背景 → 半透明质感；
              · 卡片浮在背景之上，用柔和投影表达层次（Elevation）；
              · 卡片顶部一条 1px 高光，模拟"受光"的物理感；
              · 控件统一大圆角 + 更柔和的灰阶 + 悬浮微抬升。

      ⚠ 回退方式：把 App.xaml 里的 Ui/Theme.Modern.xaml 改回 Ui/Theme.Legacy.xaml 即可
        （两套主题的资源键完全一致，窗口 XAML 不需要动）。
      ============================================================================
    -->

    <!-- ============================ 调色板 ============================ -->
    <Color x:Key="AccentColor">#2F7DF6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#2F7DF6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D6AE6" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#175BC9" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F1FE" />
    <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#D8E7FD" />

    <!--
      窗口本体保持完全透明：亚克力材质由 DWM 在窗口背后合成，
      只要 WPF 这一层不画不透明底，磨砂效果就能透出来。
      若系统不支持亚克力，WindowEffects 会把下面 Acrylic* 画刷换成不透明色。
    -->
    <SolidColorBrush x:Key="WindowBrush" Color="Transparent" />

    <!--
      亚克力可控画刷。默认值 = 支持亚克力时的观感（偏白、只带一点透明），
      运行时由 WindowEffects.PublishToResources 按"材质是否生效"改写。
      ⚠ 这里刻意保持很白：用户明确要的是"白 / 浅灰"，不是灰玻璃。
    -->
    <SolidColorBrush x:Key="AcrylicWindowTintBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="AcrylicTopBarBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="AcrylicGroupBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="AcrylicCardBrush" Color="#FFFFFFFF" />

    <!-- 语义色（"是否亚克力"切换时会跟着一起被改写） -->
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RowAltBrush" Color="#0FFFFFFF" />

    <!--
      窗口底色：**纯色**。
      之前这里用的是一层径向渐变（左上亮、右下暗）+ 卡片的上下渐变，
      实际观感被反馈为"深灰太多、渐变很怪"，因此全部改成纯色。
      层次现在只由"白卡片 + 浅灰底 + 柔和投影"表达，不再靠渐变。
    -->
    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#F5F6F8" />

    <!-- 兼容别名：卡片底色统一走 CardBrush（纯白），保留这个键名是为了不改窗口 XAML -->
    <SolidColorBrush x:Key="CardGradientBrush" Color="#FFFFFFFF" />

    <!-- 分组容器顶部的一条高光（1px 纯色） -->
    <SolidColorBrush x:Key="GroupHighlightBrush" Color="#59FFFFFF" />

    <!-- 组内小标题用的浅色分隔底（音频列表表头等） -->
    <SolidColorBrush x:Key="HeaderSurfaceBrush" Color="#FAFBFC" />

    <!-- 边框：极浅的中性灰，只用于收边，不承担层级区分 -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#16000000" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#12000000" />
    <SolidColorBrush x:Key="GroupBorderBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#18000000" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#2A000000" />

    <SolidColorBrush x:Key="TextBrush" Color="#1C1E22" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#636A76" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#AAB0BA" />
    <SolidColorBrush x:Key="ChipBrush" Color="#E9ECF0" />
    <SolidColorBrush x:Key="ChipSelectedBrush" Color="#2F7DF6" />

    <!--
      控件面（按钮 / 输入框 / 下拉框）用浅灰 #EEF0F3。
      原来是纯白——在白色卡片上等于没有边界，用户反馈"颜色太浅、区分度不够"。
      这里给一个比卡片略深的浅灰，再配合投影就能有明确的"可点"观感。
    -->
    <SolidColorBrush x:Key="ControlBrush" Color="#EEF0F3" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#E2E6EC" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#D4DAE3" />
    <!-- 滑轨很浅：原来是 #1F000000（偏深的灰），用户反馈"深灰太多" -->
    <SolidColorBrush x:Key="TrackBrush" Color="#E7EAEF" />
    <!-- 滚动条滑块：浅灰，别在白色卡片上拉出一条黑线 -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C6CBD3" />

    <!-- 状态条（提示/警告） -->
    <SolidColorBrush x:Key="WarningBrush" Color="#F2FFF8E1" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#4DE0B93C" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#6B5400" />

    <!-- ============================ 阴影（用层次代替边框） ============================ -->
    <!-- 卡片：淡淡的低位投影。颜色用中性灰而不是蓝灰，避免在白色卡片下发青发脏 -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="1.5" Direction="270"
                      Color="#FF7A8290" Opacity="0.13" RenderingBias="Quality" />
    <!-- 悬浮元素（按钮/下拉框）：更小的投影 -->
    <DropShadowEffect x:Key="ControlShadow" BlurRadius="6" ShadowDepth="1" Direction="270"
                      Color="#FF7A8290" Opacity="0.12" RenderingBias="Quality" />
    <!-- 顶栏：把内容区"压"在下面 -->
    <DropShadowEffect x:Key="TopBarShadow" BlurRadius="16" ShadowDepth="3" Direction="270"
                      Color="#FF7A8290" Opacity="0.14" RenderingBias="Quality" />

    <!-- ============================ 文本 ============================ -->
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SmallText" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ColumnTitle" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,3,0,5" />
    </Style>

    <Style x:Key="GroupTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1,0,7" />
    </Style>

    <!-- ============================ 两层结构：分组容器 → 功能卡片 ============================ -->

    <!--
      第 1 层：分组容器。旧主题是"灰底 + 深色边框"；这里换成几乎透明的玻璃面，
      只在需要收边的地方留一条极浅的发丝线，让卡片自己用阴影浮起来。
    -->
    <Style x:Key="GroupContainer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AcrylicGroupBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GroupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,6,8,8" />
    </Style>

    <!--
      第 2 层：功能卡片。**没有深色边框**，层次完全由
      「柔和投影 + 顶部受光渐变 + 比背景略亮的面」三件套表达。
      注意 Border 没有 ControlTemplate（它不是 Control），所以这里不用模板，
      改用"上亮下淡"的渐变背景来模拟受光面 —— 效果等价且更省一次视觉树嵌套。
    -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        <!-- 纯白卡片（原来是上下渐变，已按反馈去掉） -->
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="10,8,10,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 紧贴分组容器底部的最后一张卡：不再叠加下间距 -->
    <Style x:Key="CardLast" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <!-- ============================ 滑块 ============================ -->
    <Style x:Key="FlatSlider" TargetType="Slider">
        <Setter Property="Height" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="5" CornerRadius="2.5" Background="{StaticResource TrackBrush}"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <!-- 已填充部分：纯色，不用渐变（渐变观感已被反馈为不佳） -->
                                            <Border Height="5" CornerRadius="2.5" VerticalAlignment="Center"
                                                    Background="#4C93F5" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" Height="5" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Fill="White" Width="14" Height="14">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="5" ShadowDepth="1"
                                                                          Direction="270" Color="#FF7A8290"
                                                                          Opacity="0.35" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <Ellipse Width="14" Height="14" Stroke="#2F7DF6"
                                                         StrokeThickness="2" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 按钮 ============================ -->
    <!-- 基础按钮：无边框、扁平、悬浮时轻微"抬升"（投影 + 背景变亮） -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="13,4,13,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 外层只画投影、内层画圆角填充：避免阴影的方形底子从圆角外露出来 -->
                    <Border x:Name="Shadow" CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                              Color="#FF7A8290" Opacity="0.20" />
                        </Border.Effect>
                        <Border x:Name="Bd" Background="{StaticResource ControlBrush}" BorderThickness="0"
                                CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlPressedBrush}" />
                            <Setter TargetName="Shadow" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F6F8" />
                            <Setter TargetName="Shadow" Property="Effect" Value="{x:Null}" />
                            <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Padding" Value="10,3,10,3" />
        <!-- 文字超长时裁剪而不是换行，避免工具栏高度被内容顶下去 -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 同样拆两层：投影在外、填充在内 -->
                    <Border x:Name="Shadow" CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                              Color="#FF7A8290" Opacity="0.20" />
                        </Border.Effect>
                        <Border x:Name="Bd" Background="{StaticResource ControlBrush}" BorderThickness="0"
                                CornerRadius="6" Padding="{TemplateBinding Padding}" ClipToBounds="True"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlPressedBrush}" />
                            <Setter TargetName="Shadow" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F6F8" />
                            <Setter TargetName="Shadow" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主行动按钮（例如"训练模型"） -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource AccentBrush}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Direction="270"
                                              Color="#FF2F7DF6" Opacity="0.34" />
                        </Border.Effect>
                        <TextBlock Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#4D9AA3B2" />
                            <Setter TargetName="Bd" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 总开关：胶囊滑块开关 ============================ -->
    <ControlTemplate x:Key="SwitchTemplate" TargetType="CheckBox">
        <Grid Width="38" Height="20">
            <Border x:Name="Track" CornerRadius="10" Background="#D8DCE2" />
            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left"
                     Margin="2,0,0,0">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270"
                                      Color="#FF7A8290" Opacity="0.3" />
                </Ellipse.Effect>
            </Ellipse>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.4" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Template" Value="{StaticResource SwitchTemplate}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ============================ 开关 + 文字 ============================ -->
    <Style x:Key="SwitchWithText" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="38" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10" Background="#D8DCE2" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Grid>
                        <TextBlock x:Name="Caption" Text="{TemplateBinding Content}" Margin="7,0,0,0"
                                   FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource DisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 单选小按钮（音色风格 / 效果器） ============================ -->
    <Style x:Key="ChipToggle" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- 阴影与填充分两层，避免圆角外露出方形阴影底 -->
                    <Border x:Name="Shadow" CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270"
                                              Color="#FF7A8290" Opacity="0.16" />
                        </Border.Effect>
                        <Border x:Name="Bd" Background="{StaticResource ChipBrush}" CornerRadius="6"
                                Padding="7,4,7,4" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Txt" Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChipSelectedBrush}" />
                            <Setter TargetName="Txt" Property="TextElement.Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F6F8" />
                            <Setter TargetName="Shadow" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="Txt" Property="TextElement.Foreground"
                                    Value="{StaticResource DisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 下拉框 ============================ -->
    <Style x:Key="FlatCombo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!--
                          阴影与填充必须分成两个 Border。
                          根因：DropShadowEffect 是画在元素自身上的，阴影形状来自"元素轮廓的模糊"，
                          但它渲染出来的底子是一个**方形**的模糊矩形。把它直接加在带圆角的
                          Border 上，圆角外面就会露出方形的阴影边——看起来就是"圆角 + 方角两层"。
                          拆开之后：外层只负责投影、本身不画任何东西，内层画圆角白底把中心盖实，
                          于是只剩一圈柔和的圆角光晕。
                        -->
                        <Border x:Name="BdShadow" CornerRadius="6" Margin="0,1,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                                  Color="#FF7A8290" Opacity="0.14" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Bd" Background="{StaticResource ControlBrush}" BorderThickness="0"
                                CornerRadius="6" SnapsToDevicePixels="True" />
                        <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0" Focusable="False"
                                      ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="9,0,24,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False" />
                        <!-- 箭头不参与命中测试，否则点它不会展开下拉框。
                             两个方向的箭头各一个、切换可见性，不用旋转（旋转方向容易搞错）。 -->
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Center"
                              Width="12" Height="12" Margin="0,0,8,0" IsHitTestVisible="False">
                            <Path x:Name="ArrowCollapsed" Data="M 8 1 L 3 6 L 8 11" Stroke="#6B7280"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Path x:Name="ArrowExpanded" Data="M 1 3 L 6 8 L 11 3" Stroke="#6B7280"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Grid>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                               PopupAnimation="Fade">
                            <!-- 同样拆两层：外层投影 + 内层不透明圆角填充。
                                 内层必须**不透明**，否则阴影会从底下透上来，又变成两层背景。 -->
                            <Grid MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0">
                                <Border CornerRadius="8" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                                          Color="#FF7A8290" Opacity="0.26" />
                                    </Border.Effect>
                                </Border>
                                <Border Background="#FFFFFFFF" BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" MaxHeight="260"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="3,4,3,4">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                        </Trigger>
                        <!-- 收起：箭头朝左；展开：换成朝下的箭头 -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="ArrowCollapsed" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ArrowExpanded" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ArrowExpanded" Property="Stroke" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 小图标按钮：用于下拉框旁的操作入口（如打开模型文件夹） -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource ControlBrush}" BorderThickness="0"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlatComboItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="9,5,9,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="3,1,3,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftHoverBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 折叠箭头按钮 ============================ -->
    <!--
      用「两个几何图形 + DataTrigger」而不是旋转：旋转的命名对象在模板里不易可靠取到，
      而且这里只有两种朝向，直接切换 Data 更直观、也不会出现朝上/朝右这类错向。
      Button.Tag 绑定窗口上的布尔属性（如 GateExpanded）：True = 展开（朝下），False = 收起（朝左）。
    -->
    <Style x:Key="ExpanderButton" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                        <Grid>
                            <Path x:Name="ArrowCollapsed" Data="M 6 0 L 1 5 L 6 10" Stroke="#8A93A3"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Path x:Name="ArrowExpanded" Data="M 0 1 L 5 6 L 10 1" Stroke="#8A93A3"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="ArrowCollapsed" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ArrowExpanded" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChipBrush}" />
                            <Setter TargetName="ArrowCollapsed" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="ArrowExpanded" Property="Stroke" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      工具栏第二行的三个设备下拉框。基于 FlatCombo 加宽，让设备名尽量显示完整
      （原来固定 98 DIP，"扬声器 (MIXLINE)" 这类名字只能看到一半）。
      MinWidth 而不是 Width：窗口宽度固定，三组"标签 + 框"用等宽星号列均匀铺满整行。
    -->
    <Style x:Key="DeviceCombo" TargetType="ComboBox" BasedOn="{StaticResource FlatCombo}">
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Height" Value="27" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- 音频列表行 -->
    <Style x:Key="TrackRowButton" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      列表行里的按键控件：「设快捷键 / 设同步键」。
      外观做成和工具栏按钮一致的圆角小框，而不是普通按钮——
      这样一行里放两个也不挤，也不会把文件名挤掉。
      禁用（「同步按住键」总开关未打开）时依然保留 hover 反馈，只是更淡，
      否则用户会以为控件坏了、连点都点不动。
    -->
    <Style x:Key="InputBoxButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <!--
          它是"看起来像输入框的按钮"，不是真的文本输入框：
          焦点必须不落在它上面，否则点一下之后系统输入法（IME）会把这里当成文本输入目标，
          中文输入法会被唤起来、按键也录不进去（用户反馈必须切英文输入法才能录入）。
        -->
        <Setter Property="Focusable" Value="False" />
        <!-- 行内边距给 1：列宽已经按实测文字宽度算好，多留的每一点都从文件名那里抢 -->
        <Setter Property="Margin" Value="1,3,1,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#EDF0F4" BorderThickness="0"
                            CornerRadius="5" Padding="5,1,5,1" SnapsToDevicePixels="True">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            <Setter TargetName="Label" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 移除按钮：内容用几何图形绘制，避免依赖字体里的 ✕ 字形 -->
    <Style x:Key="RemoveButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                        <Path x:Name="Cross" Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="#9AA3B0" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26E5484D" />
                            <Setter TargetName="Cross" Property="Stroke" Value="#D64545" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#40E5484D" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 自绘标题栏按钮 ============================ -->
    <!--
      标题栏由我们自己画（见 MainWindow.xaml 的 WindowChrome 注释），因此这两个按钮也要自绘。
      尺寸按 Windows 惯例：45×32，无边框透明底，悬停才出现浅色块。
      内容用 "min" / "close" 字符串标识，真正的图形在模板里用 Path 画，
      避免依赖字体里是否有 ✕ / – 字形（与主题里其它图形按钮的做法一致）。
    -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <Path x:Name="Glyph" Data="M 0 5 L 10 5" Stroke="#4A4F57" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="#1C1E22" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#24000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <Path x:Name="Glyph" Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="#4A4F57"
                              StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 关闭按钮悬停用系统惯例的红色，用户一眼就知道这是关闭 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E5484D" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C93B40" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 滚动条（细圆角，融入浅色卡片） ============================ -->
    <Style x:Key="SlimScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3" Margin="2,0,2,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlimScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="8" />
                            <Setter Property="Width" Value="Auto" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 电平条的"未达到"遮罩色（跟着卡片面走，避免挡出一块死白） -->
    <SolidColorBrush x:Key="LevelMaskBrush" Color="#24FFFFFF" />

</ResourceDictionary>
