<Project Sdk="Microsoft.NET.Sdk">
  <!--
    故意不用 ProjectReference：本机环境里"引用主工程"的构建会静默失败
    （DpdfProbe 也一样，与本探针无关），因此这里直接编译被测源码。
    好处是探针与被测文件逐字节一致，且不依赖 WPF/主工程。

    覆盖的回归项：
      · DenoiseEffect        块长无关性 / 固定延迟 / 帧对齐 / 干湿混合 / 直通 / 模型切换 / 超时
      · LoudnessBalanceEffect 峰值保护是否真的立即生效 / 静音与底噪是否被加大 / 是否收敛到目标
      · ToneStyleEffect      未选择风格时构造、之后再选风格，预设各段是否全部生效
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DspProbe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\Core\AppConfig.cs" />
    <Compile Include="..\..\..\Core\Log.cs" />
    <Compile Include="..\..\..\Dsp\DenoiseEffect.cs" />
    <Compile Include="..\..\..\Dsp\DenoiseModels.cs" />
    <Compile Include="..\..\..\Dsp\CreativeEffect.cs" />
    <Compile Include="..\..\..\Dsp\HardTuneEffect.cs" />
    <Compile Include="..\..\..\Dsp\MegaphoneDistortionEffect.cs" />
    <Compile Include="..\..\..\Dsp\PitchDetector.cs" />
    <Compile Include="..\..\..\Dsp\PitchShifter.cs" />
    <Compile Include="..\..\..\Dsp\IAudioEffect.cs" />
    <Compile Include="..\..\..\Dsp\LoudnessBalanceEffect.cs" />
    <Compile Include="..\..\..\Dsp\SmoothedGain.cs" />
    <Compile Include="..\..\..\Dsp\SpectralDenoiseModel.cs" />
    <Compile Include="..\..\..\Dsp\ToneStyleEffect.cs" />
  </ItemGroup>
</Project>
